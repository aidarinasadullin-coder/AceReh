<Application x:Class="SnowMeltingCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Примитивные токены дизайн-системы -->
                <ResourceDictionary Source="Themes/PrimitiveSpacing.xaml"/>
                <ResourceDictionary Source="Themes/PrimitiveRadius.xaml"/>

                <!-- Токены бренда 2026: палитра, градиенты, типографика
                     (Фаза 0 редизайна; порядок важен — Colors раньше Gradients) -->
                <ResourceDictionary Source="Themes/Tokens.Colors.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Gradients.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Typography.xaml"/>

                <!-- Ресурсы индикаторов пересчёта -->
                <ResourceDictionary Source="Themes/RecalcIndicators.xaml"/>

                <!-- Ресурсы приложения -->
                <ResourceDictionary Source="Resources/Dictionary.xaml"/>

                <!-- Каркас окна (Фаза 1): после Dictionary.xaml — см. ревью Ф1 (F8) -->
                <ResourceDictionary Source="Themes/Shell.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================ -->
            <!-- КОРПОРАТИВНЫЕ ЦВЕТА REHAU                    -->
            <!-- Фаза 0 редизайна: значения перепривязаны на  -->
            <!-- палитру 2026. Канонический источник —        -->
            <!-- Themes/Tokens.Colors.xaml; значения ниже     -->
            <!-- поддерживаются с ним в согласии.             -->
            <!-- ============================================ -->

            <!-- Основные брендовые цвета (стр. 13 брендбука; Brand.Red / Brand.Teal) -->
            <Color x:Key="RehauRed">#E50040</Color>
            <Color x:Key="RehauTeal">#4FC7B5</Color>
            <Color x:Key="RehauGray">#4E4E4E</Color>
            <Color x:Key="RehauBlack">#000000</Color>
            <Color x:Key="RehauWhite">#FFFFFF</Color>

            <!-- Дополнительные цвета (стр. 15; Brand.Red.Soft / Brand.Red.Dark /
                 Brand.Teal.Soft / Brand.Teal.Deep). #1D1D1B, #575756, #FF6B6B,
                 #B3002E, #6BD3C8, #2E9B8E — вне палитры 2026, выведены из употребления. -->
            <Color x:Key="RehauRedLight">#F4555E</Color>
            <Color x:Key="RehauRedDark">#B60034</Color>
            <Color x:Key="RehauTealLight">#72D2C4</Color>
            <Color x:Key="RehauTealDark">#2F776D</Color>

            <!-- Фоновые цвета (нейтральные поверхности, вне серой линейки брендбука) -->
            <Color x:Key="RehauBackgroundLight">#FAFAFA</Color>
            <Color x:Key="RehauBackgroundGray">#F5F5F5</Color>
            <Color x:Key="RehauCardBackground">#FFFFFF</Color>

            <!-- Прозрачные фоновые цвета: tint дополнительных цветов с альфой ~28 %
                 (Brand.Red.Tint / Brand.Teal.Pale, §2.2 бренд-дока) -->
            <Color x:Key="RehauRedLightOpacity">#47FCC2B8</Color>
            <Color x:Key="RehauTealLightOpacity">#4795DDD3</Color>

            <!-- ============================================ -->
            <!-- СЕРАЯ ПАЛИТРА (для индикаторов и UI)         -->
            <!-- Границы/disabled перепривязаны на серую      -->
            <!-- линейку стр. 14 (Brand.Gray.100/300/600/800);-->
            <!-- Gray50–Gray200 — нейтральные поверхности.    -->
            <!-- ============================================ -->
            <Color x:Key="Gray50">#FAFAFA</Color>
            <Color x:Key="Gray100">#F5F5F5</Color>
            <Color x:Key="Gray200">#EEEEEE</Color>
            <Color x:Key="Gray300">#E4E4E4</Color>
            <Color x:Key="Gray400">#B0B0B0</Color>
            <Color x:Key="Gray500">#818181</Color>
            <Color x:Key="Gray600">#4E4E4E</Color>
            <Color x:Key="Gray700">#4E4E4E</Color>
            <Color x:Key="Gray800">#4E4E4E</Color>
            <Color x:Key="Gray900">#000000</Color>

            <!-- Семантические цвета (§2.3 бренд-дока; Status.* в Tokens.Colors).
                 Warning — единственное документированное исключение: функциональный
                 янтарный #FFB300 только для статусных полос и бейджей. -->
            <Color x:Key="ErrorRed">#E50040</Color>
            <Color x:Key="WarningOrange">#FFB300</Color>
            <Color x:Key="SuccessGreen">#3F9F91</Color>
            <Color x:Key="InfoBlue">#2F776D</Color>

            <!-- ============================================ -->
            <!-- SOLID COLOR BRUSHES -->
            <!-- ============================================ -->
            
            <!-- Брендовые кисти -->
            <SolidColorBrush x:Key="RehauRedBrush" Color="{StaticResource RehauRed}"/>
            <SolidColorBrush x:Key="RehauTealBrush" Color="{StaticResource RehauTeal}"/>
            <SolidColorBrush x:Key="RehauGrayBrush" Color="{StaticResource RehauGray}"/>
            <SolidColorBrush x:Key="RehauBlackBrush" Color="{StaticResource RehauBlack}"/>
            <SolidColorBrush x:Key="RehauWhiteBrush" Color="{StaticResource RehauWhite}"/>
            
            <!-- Производные кисти -->
            <SolidColorBrush x:Key="RehauRedLightBrush" Color="{StaticResource RehauRedLight}"/>
            <SolidColorBrush x:Key="RehauRedDarkBrush" Color="{StaticResource RehauRedDark}"/>
            <SolidColorBrush x:Key="RehauTealLightBrush" Color="{StaticResource RehauTealLight}"/>
            <SolidColorBrush x:Key="RehauTealDarkBrush" Color="{StaticResource RehauTealDark}"/>
            
            <!-- Фоновые кисти -->
            <SolidColorBrush x:Key="RehauBackgroundBrush" Color="{StaticResource RehauBackgroundLight}"/>
            <SolidColorBrush x:Key="RehauBackgroundGrayBrush" Color="{StaticResource RehauBackgroundGray}"/>
            <SolidColorBrush x:Key="RehauCardBrush" Color="{StaticResource RehauCardBackground}"/>
            
            <!-- Прозрачные фоновые кисти -->
            <SolidColorBrush x:Key="RehauRedLightOpacityBrush" Color="{StaticResource RehauRedLightOpacity}"/>
            <SolidColorBrush x:Key="RehauTealLightOpacityBrush" Color="{StaticResource RehauTealLightOpacity}"/>

            <!-- ============================================ -->
            <!-- SEMANTIC BRUSHES (Border, Text, Icon)         -->
            <!-- ============================================ -->
            
            <!-- Границы -->
            <SolidColorBrush x:Key="Color.Border.Default" Color="{StaticResource Gray300}"/>
            <SolidColorBrush x:Key="Color.Border.Error" Color="{StaticResource ErrorRed}"/>
            <SolidColorBrush x:Key="Color.Border.Success" Color="{StaticResource SuccessGreen}"/>
            <SolidColorBrush x:Key="Color.Border.Warning" Color="{StaticResource WarningOrange}"/>
            <!-- Индикатор пересчёта/процесса — бирюзовая ветка (§2.3; замена Material-синего) -->
            <SolidColorBrush x:Key="Color.Border.Processing" Color="{StaticResource RehauTeal}"/>
            
            <!-- Текст -->
            <SolidColorBrush x:Key="Color.Text.Primary" Color="{StaticResource Gray900}"/>
            <SolidColorBrush x:Key="Color.Text.Secondary" Color="{StaticResource Gray600}"/>
            <SolidColorBrush x:Key="Color.Text.Disabled" Color="{StaticResource Gray400}"/>
            <SolidColorBrush x:Key="Color.Text.Brand" Color="{StaticResource RehauRed}"/>
            <SolidColorBrush x:Key="Color.Text.OnBrand" Color="{StaticResource RehauWhite}"/>

            <!-- ============================================ -->
            <!-- BACKGROUND COLORS (без градиентов) -->
            <!-- ============================================ -->
            
            <!-- Цвет для карточек результатов (плоский) -->
            <SolidColorBrush x:Key="RehauResultCardBrush" Color="#F8F8F8"/>

            <!-- ============================================ -->
            <!-- TYPOGRAPHY -->
            <!-- ============================================ -->
            
            <!-- Основной шрифт приложения Inter -->
            <FontFamily x:Key="FontFamily.Main">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
            
            <!-- Варианты шрифтов Inter -->
            <FontFamily x:Key="FontFamily.Inter.Light">pack://application:,,,/Assets/Fonts/#Inter Light</FontFamily>
            <FontFamily x:Key="FontFamily.Inter.Medium">pack://application:,,,/Assets/Fonts/#Inter Medium</FontFamily>
            <FontFamily x:Key="FontFamily.Inter.Bold">pack://application:,,,/Assets/Fonts/#Inter Bold</FontFamily>
            <FontFamily x:Key="FontFamily.Inter.ExtraBold">pack://application:,,,/Assets/Fonts/#Inter ExtraBold</FontFamily>
            <FontFamily x:Key="FontFamily.Inter.Black">pack://application:,,,/Assets/Fonts/#Inter Black</FontFamily>

            <!-- ============================================ -->
            <!-- MATERIALDESIGN COLOR OVERRIDES -->
            <!-- ============================================ -->
            
            <!-- Primary (красный REHAU) -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource RehauRedLight}"/>
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource RehauRed}"/>
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{StaticResource RehauRedDark}"/>
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="White"/>

            <!-- Secondary (бирюзовый REHAU) -->
            <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{StaticResource RehauTealLight}"/>
            <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="Black"/>
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource RehauTeal}"/>
            <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="{StaticResource RehauTealDark}"/>
            <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="White"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
