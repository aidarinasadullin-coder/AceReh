<Application x:Class="SnowMeltingCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:configuration="clr-namespace:SnowMeltingCalculator.Configuration"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    
    <Application.Resources>
        <ResourceDictionary>
            <!-- MaterialDesign темы с цветами РЕХАУ: Красный (#E50040) и Зелёный (#44C7B5) -->
            <ResourceDictionary.MergedDictionaries>
                <!-- MaterialDesign базовые темы -->
                <materialDesign:BundledTheme BaseTheme="Light" 
                                              PrimaryColor="Red" 
                                              SecondaryColor="Teal"/>
                
                <!-- MaterialDesign стандартные стили -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                
                <!-- Ресурсы приложения -->
                <ResourceDictionary Source="Resources/Dictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Кастомные цвета РЕХАУ -->
            <Color x:Key="RehauRed">#E50040</Color>
            <Color x:Key="RehauGreen">#44C7B5</Color>
            <Color x:Key="RehauBlack">#000000</Color>
            <Color x:Key="RehauWhite">#FFFFFF</Color>

            <!-- SolidColorBrush для использования в XAML -->
            <SolidColorBrush x:Key="RehauRedBrush" Color="{StaticResource RehauRed}"/>
            <SolidColorBrush x:Key="RehauGreenBrush" Color="{StaticResource RehauGreen}"/>
            <SolidColorBrush x:Key="RehauBlackBrush" Color="{StaticResource RehauBlack}"/>
            <SolidColorBrush x:Key="RehauWhiteBrush" Color="{StaticResource RehauWhite}"/>

            <!-- Переопределение Primary и Secondary цветов MaterialDesign -->
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#FF6B6B"/>
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource RehauRed}"/>
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#B3002E"/>
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="White"/>

            <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="#6BD3C8"/>
            <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="Black"/>
            <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource RehauGreen}"/>
            <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="#2E9B8E"/>
            <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="White"/>

            <!-- Локатор ViewModels -->
            <configuration:ViewModelLocator x:Key="ViewModelLocator"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>