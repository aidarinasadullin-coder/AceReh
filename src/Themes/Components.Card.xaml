<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Компоненты: Card / FormCard (Фаза 2 редизайна, эталон renders/02).
        Только токены Tokens.* + Radius/Spacing + именованные White/Black/
        Transparent (решение в ViewTokenHygieneTests). Тень — мягкая, как
        «shadow-card» эталона; при массовых чипах эффект переопределять null.

        Мержится ПОСЛЕ Tokens.*, ДО Dictionary.xaml (порядок закреплён ADR-006).
    -->

    <!-- Card: базовая поверхность-карточка (белая, hairline, мягкая тень) -->
    <Style x:Key="Card.Root" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.MD.Thickness}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                  Opacity="0.08" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Card.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
    </Style>

    <!-- Вспомогательный текст в правом краю заголовка карточки -->
    <Style x:Key="Card.HeaderAux" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
    </Style>

    <!-- FormCard: карточка формы (заголовок + сетка полей + подсказки) -->
    <Style x:Key="FormCard.Root" TargetType="Border" BasedOn="{StaticResource Card.Root}">
        <!-- Поля формы чаще собраны плотнее: отступ как у Card, сетка — у потребителя -->
    </Style>

    <Style x:Key="FormCard.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="FormCard.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</ResourceDictionary>
