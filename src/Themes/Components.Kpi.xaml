<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ap="clr-namespace:SnowMeltingCalculator.AttachedProperties">

    <!--
        Компоненты: KpiChip (соотношение 2:1) / HeroKpi (Фаза 2 редизайна,
        эталоны renders/02 и tokens.css .chip/.hero). Только токены.

        Соотношение 2:1 держит attached property Aspect.Ratio (ADR-006:
        Height = ActualWidth / ratio) — сеттером стиля, чтобы чип тянулся
        по ширине сетки и не ломал раскладку панелей.
    -->

    <!-- KpiChip: белая плитка KPI 2:1 (значение + единица + подпись) -->
    <Style x:Key="KpiChip.Root" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.SM.Thickness}"/>
        <Setter Property="ap:AspectRatio.Ratio" Value="2"/>
    </Style>

    <Style x:Key="KpiChip.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
    </Style>

    <Style x:Key="KpiChip.ValueAccent" TargetType="TextBlock" BasedOn="{StaticResource KpiChip.Value}">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Red.Brush}"/>
    </Style>

    <Style x:Key="KpiChip.ValueTeal" TargetType="TextBlock" BasedOn="{StaticResource KpiChip.Value}">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Teal.Deep.Brush}"/>
    </Style>

    <Style x:Key="KpiChip.Unit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="KpiChip.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- HeroKpi: ключевой показатель на градиенте Red.Intensive (≤1 акцента на экран) -->
    <Style x:Key="HeroKpi.Root" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brand.Gradient.Red.Intensive}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.LG}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.LG.Thickness}"/>
    </Style>

    <Style x:Key="HeroKpi.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <Style x:Key="HeroKpi.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Display}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="HeroKpi.Unit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="HeroKpi.Detail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

</ResourceDictionary>
