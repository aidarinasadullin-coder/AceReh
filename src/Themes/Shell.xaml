<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Каркас окна (Фаза 1 редизайна): светлая шапка, степпер, панель
        «Сводка», статус-бар. Только токены Themes/Tokens.* (ViewTokenHygieneTests
        ratchet); именованные цвета WPF разрешены решением в тесте.

        Требует: Tokens.Colors.xaml, Tokens.Typography.xaml, Dictionary.xaml
        (Button.*). Мержится в App.xaml ПОСЛЕ Dictionary.xaml (ревью Ф1, F8).
    -->

    <!-- ============================================ -->
    <!-- ШАПКА                                        -->
    <!-- ============================================ -->

    <!-- Светлая поверхность шапки (замена красного баннера).
         Правый паддинг = 0: колонка кнопок управления окном (Фаза 3Б)
         прижимается к краю окна; отступ контентных элементов шапки —
         их собственными Margin. -->
    <Style x:Key="Shell.HeaderRoot" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,0,0,0"/>
    </Style>

    <Style x:Key="Shell.BrandTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.BrandSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.HeaderDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="16,12"/>
        <Setter Property="Background" Value="{DynamicResource Brand.Gray.100.Brush}"/>
    </Style>

    <Style x:Key="Shell.HeaderModuleTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.800.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.ProjectName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Кнопки управления окном (Фаза 3Б): системный стиль Win11 —
         ячейки 46×56, вплотную к правому верхнему краю окна;
         hover — серая заливка, «закрыть» — фирменный красный -->
    <Style x:Key="Shell.WindowButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Gray.100.Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.800.Brush}"/>
            </Trigger>
            <!-- Gray.200 в шкале нет — ближайший шаг pressed: Gray.300 -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Gray.300.Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.800.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shell.WindowCloseButton" TargetType="Button" BasedOn="{StaticResource Shell.WindowButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Red.Brush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Red.Dark.Brush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Пункт меню «Файл» на светлой шапке -->
    <Style x:Key="Shell.FileMenuItem" TargetType="MenuItem">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.800.Brush}"/>
    </Style>

    <!-- ============================================ -->
    <!-- СТЕППЕР                                      -->
    <!-- ============================================ -->

    <Style x:Key="Shell.StepItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Padding" Value="10,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.800.Brush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Gray.100.Brush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Red.Tint.Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand.Red.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кружок с номером шага -->
    <Style x:Key="Shell.StepBadge" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Red.Brush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shell.StepBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shell.StepTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Правый слот состояния шага: ✓ готов · ⚠ ошибка · ⟳ пересчёт · ● черновик -->
    <Style x:Key="Shell.StepStatusGlyph" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Text" Value="●"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.300.Brush}"/>
        <Setter Property="ToolTip" Value="Черновик"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StepStatus}" Value="Ready">
                <Setter Property="Text" Value="✓"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand.Teal.Success.Brush}"/>
                <Setter Property="ToolTip" Value="Готов"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StepStatus}" Value="Error">
                <Setter Property="Text" Value="⚠"/>
                <Setter Property="Foreground" Value="{DynamicResource Status.Warning.Brush}"/>
                <Setter Property="ToolTip" Value="Ошибка валидации"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StepStatus}" Value="Recalculating">
                <Setter Property="Text" Value="⟳"/>
                <Setter Property="Foreground" Value="{DynamicResource Brand.Teal.Brush}"/>
                <Setter Property="ToolTip" Value="Пересчёт"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопка сворачивания степпера -->
    <Style x:Key="Shell.SidebarToggleButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brand.Gray.100.Brush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================ -->
    <!-- СВОДКА                                       -->
    <!-- ============================================ -->

    <!-- Глиф разворачивания (Фаза 3Б): квадрат ↔ двойной квадрат по WindowState -->
    <Style x:Key="Shell.WindowMaximizeGlyph" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource Icon.WindowMaximize}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                <Setter Property="Data" Value="{StaticResource Icon.WindowRestore}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Shell.SummaryRoot" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Width" Value="240"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="Shell.SummaryHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="0,4,0,12"/>
    </Style>

    <Style x:Key="Shell.SummarySection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <Style x:Key="Shell.SummaryRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style x:Key="Shell.SummaryLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.SummaryValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.SummaryValueAccent" TargetType="TextBlock" BasedOn="{StaticResource Shell.SummaryValue}">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Red.Brush}"/>
    </Style>

    <Style x:Key="Shell.SummaryValueTeal" TargetType="TextBlock" BasedOn="{StaticResource Shell.SummaryValue}">
        <Setter Property="Foreground" Value="{DynamicResource Brand.Teal.Brush}"/>
    </Style>

    <!-- ============================================ -->
    <!-- СТАТУС-БАР                                   -->
    <!-- ============================================ -->

    <Style x:Key="Shell.StatusBarRoot" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- Скошенная плашка текущего модуля (фирменный приём, стр. 55–57 брендбука) -->
    <Style x:Key="Shell.StatusPlate" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brand.Teal.Brush}"/>
        <Setter Property="Padding" Value="10,0,14,0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="Shell.StatusPlateText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Shell.StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Gray.600.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Shell.RecalcText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brand.Teal.Deep.Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

</ResourceDictionary>
