<!--
    ================================================================================
    REHAU Снеготаяние - Система индикаторов пересчёта
    ================================================================================
    
    Назначение: Стили для индикаторов состояния пересчёта данных
    
    Соответствует: design_guidelines.md
    - Цвета: RehauRed #E50040, RehauTeal #4FC7B5
    - Типографика: Inter Medium 11-14px
    - Отступы: 8px, 12px, 16px
    - Скругления: 8px (MD), 999px (Full)
    
    Зависимости:
    - App.xaml (RehauRed, RehauTeal, RehauWhite, Gray100-Gray900, ErrorRed, WarningOrange, InfoBlue)
    - PrimitiveSpacing.xaml (Spacing.XS, Spacing.SM, Spacing.MD)
    - PrimitiveRadius.xaml (Radius.MD, Radius.Full)
    
    ================================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================ -->
    <!-- ЦВЕТА ДЛЯ ИНДИКАТОРОВ (уникальные, отсутствуют в App.xaml)                   -->
    <!-- ============================================================================ -->
    
    <!-- Warning: жёлтый фон, оранжевая рамка -->
    <Color x:Key="WarningBackground">#FFF8E8</Color>
    <Color x:Key="WarningBorder">#FFB300</Color>
    
    <!-- Processing: тил-семейство (Ф7.3 — замена Material-синего;
         лёгкая схема, как у Warning/Success этого контрола; тёмная панель
         Teal.Deep с белым текстом — оверлей расчёта в MainWindow). -->
    <Color x:Key="ProcessingBackground">#95DDD3</Color>
    <Color x:Key="ProcessingBorder">#2F776D</Color>
    <Color x:Key="ProcessingText">#2F776D</Color>
    
    <!-- ============================================================================ -->
    <!-- ЦВЕТА ИНДИКАТОРОВ (Component Tokens)                                         -->
    <!-- ============================================================================ -->
    
    <!-- 
        БЕЙДЖИ НАВИГАЦИИ 
        Используются для отображения статуса актуальности рядом с названием вкладки
    -->
    <SolidColorBrush x:Key="Badge.Bg.Valid" 
                     Color="{StaticResource RehauTeal}"/>
    <SolidColorBrush x:Key="Badge.Bg.Invalid" 
                     Color="{StaticResource RehauRed}"/>
    <SolidColorBrush x:Key="Badge.Foreground" 
                     Color="{StaticResource RehauWhite}"/>
    
    <!-- 
        ИНДИКАТОРЫ ПЕРЕСЧЁТА
        Фоны для разных состояний индикатора внутри вкладок
    -->
    <SolidColorBrush x:Key="RecalcIndicator.Bg.Info" 
                     Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Bg.Warning" 
                     Color="{StaticResource WarningBackground}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Bg.Processing" 
                     Color="{StaticResource ProcessingBackground}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Bg.Success" 
                     Color="{StaticResource RehauTealLightOpacity}"/>
    
    <!-- Цвета текста для индикаторов -->
    <SolidColorBrush x:Key="RecalcIndicator.Text.Info" 
                     Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Text.Warning" 
                     Color="{StaticResource WarningOrange}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Text.Processing" 
                     Color="{StaticResource ProcessingText}"/>
    <SolidColorBrush x:Key="RecalcIndicator.Text.Success" 
                     Color="{StaticResource RehauTeal}"/>

    <!-- ============================================================================ -->
    <!-- СТИЛИ БЕЙДЖЕЙ НАВИГАЦИИ (Navigation Badges)                                  -->
    <!-- ============================================================================ -->
    
    <!--
        Badge.Navigation
        Круглый бейдж для отображения в навигации
        Размер: 20×20px
        Скругление: полностью круглый (999px)
    -->
    <Style x:Key="Badge.Navigation" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Background" Value="{StaticResource Badge.Bg.Valid}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    
    <!--
        Badge.Text
        Текст внутри бейджа (счётчик или точка)
        Шрифт: Inter Medium, 11px
        Цвет: белый
    -->
    <Style x:Key="Badge.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Main}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Badge.Foreground}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================================ -->
    <!-- СТИЛИ ИНДИКАТОРОВ ПЕРЕСЧЁТА (Tab Indicators)                                  -->
    <!-- ============================================================================ -->
    
    <!--
        RecalcIndicator.Container
        Контейнер индикатора пересчёта
        Стиль: Card с border
        Padding: 16,12
        Margin: 0,0,0,16
        Скругление: 8px
    -->
    <Style x:Key="RecalcIndicator.Container" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Info}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    
    <!--
        RecalcIndicator.Text
        Текстовое сообщение в индикаторе
        Шрифт: Inter Medium, 14px
        Цвет: зависит от состояния
    -->
    <Style x:Key="RecalcIndicator.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Main}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Info}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!--
        RecalcIndicator.Icon
        Иконка в индикаторе (Path внутри Viewbox)
        Размер: 20×20px
        Отступ справа: 12px
        Цвет: зависит от состояния
    -->
    <Style x:Key="RecalcIndicator.Icon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Info}"/>
    </Style>

    <!-- ============================================================================ -->
    <!-- СТИЛИ СОСТОЯНИЙ (State-based Styles)                                         -->
    <!-- ============================================================================ -->
    
    <!--
        Состояние Warning (требуется пересчёт)
        Жёлтый фон (#FFF8E8), оранжевая рамка (#FFB300), оранжевый текст
    -->
    <Style x:Key="RecalcIndicator.Container.Warning" TargetType="Border" 
           BasedOn="{StaticResource RecalcIndicator.Container}">
        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Warning}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Warning}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Text.Warning.Style" TargetType="TextBlock" 
           BasedOn="{StaticResource RecalcIndicator.Text}">
        <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Warning}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Icon.Warning" TargetType="Path" 
           BasedOn="{StaticResource RecalcIndicator.Icon}">
        <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Warning}"/>
    </Style>
    
    <!--
        Состояние Processing (идёт пересчёт)
        Тил-семейство (Ф7.3): фон Brand.Teal.Pale, рамка/текст Brand.Teal.Deep
    -->
    <Style x:Key="RecalcIndicator.Container.Processing" TargetType="Border" 
           BasedOn="{StaticResource RecalcIndicator.Container}">
        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Processing}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Processing}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Text.Processing.Style" TargetType="TextBlock" 
           BasedOn="{StaticResource RecalcIndicator.Text}">
        <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Processing}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Icon.Processing" TargetType="Path" 
           BasedOn="{StaticResource RecalcIndicator.Icon}">
        <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Processing}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform CenterX="10" CenterY="10"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--
        Состояние Success (пересчёт завершён)
        Зелёный фон, зелёный текст, зелёная граница
    -->
    <Style x:Key="RecalcIndicator.Container.Success" TargetType="Border" 
           BasedOn="{StaticResource RecalcIndicator.Container}">
        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Success}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Success}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Text.Success.Style" TargetType="TextBlock" 
           BasedOn="{StaticResource RecalcIndicator.Text}">
        <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Success}"/>
    </Style>
    
    <Style x:Key="RecalcIndicator.Icon.Success" TargetType="Path" 
           BasedOn="{StaticResource RecalcIndicator.Icon}">
        <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Success}"/>
    </Style>

    <!-- ============================================================================ -->
    <!-- СТИЛИ СОСТОЯНИЙ БЕЙДЖЕЙ (Badge State Styles)                                  -->
    <!-- ============================================================================ -->
    
    <!--
        Бейдж в состоянии "требуется пересчёт"
        Красный фон
    -->
    <Style x:Key="Badge.Navigation.Warning" TargetType="Border" 
           BasedOn="{StaticResource Badge.Navigation}">
        <Setter Property="Background" Value="{StaticResource Badge.Bg.Invalid}"/>
    </Style>
    
    <!--
        Бейдж в состоянии "данные актуальны"
        Зелёный фон
    -->
    <Style x:Key="Badge.Navigation.Valid" TargetType="Border" 
           BasedOn="{StaticResource Badge.Navigation}">
        <Setter Property="Background" Value="{StaticResource Badge.Bg.Valid}"/>
    </Style>

</ResourceDictionary>
