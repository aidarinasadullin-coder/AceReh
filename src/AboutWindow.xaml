<Window x:Class="SnowMeltingCalculator.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="О программе"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="{StaticResource FontFamily.Main}"
        TextElement.Foreground="{DynamicResource Brand.Black.Brush}">

    <!--
        «О программе» (Ф7.2, рендер 06b): лёгкий модальный диалог — 6px
        красная полоса (Red.Intensive), цветной логотип, строки: версия,
        данные, слоган, ©. Формулировка «данные СП» (журнал п.10), не
        «расчёт по СП». Логотип — иконка + текстовый wordmark «РЕХАУ»:
        logo_main_color.svg SharpVectors рендерит некорректно (комментарий
        MainWindow.xaml к шапке), локап повторяет шапку.
    -->
    <StackPanel>
        <Border Height="6" Background="{DynamicResource Brand.Gradient.Red.Intensive}"/>

        <StackPanel Margin="30,26,30,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="34" Height="34"
                        Background="White"
                        BorderBrush="{DynamicResource Brand.Gray.100.Brush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Brand/logo_icon_color.svg"
                                     Width="26" Height="26"
                                     Stretch="Uniform"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="РЕХАУ"
                           FontSize="{StaticResource Font.Size.Title}"
                           FontWeight="Bold"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Калькулятор снеготаяния"
                       FontSize="{StaticResource Font.Size.Section}"
                       FontWeight="ExtraBold"/>
            <TextBlock Text="Расчёт систем обогрева открытых площадок РЕХАУ"
                       FontSize="{StaticResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brand.Gray.600.Brush}"
                       Margin="0,4,0,16"/>

            <StackPanel TextBlock.FontSize="{StaticResource Font.Size.Caption}"
                        Margin="0,0,0,4">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Версия" Foreground="{DynamicResource Brand.Gray.600.Brush}"/>
                    <TextBlock Grid.Column="1" x:Name="VersionText" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Данные" Foreground="{DynamicResource Brand.Gray.600.Brush}"/>
                    <TextBlock Grid.Column="1" Text="СП 131.13330.2025" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Слоган" Foreground="{DynamicResource Brand.Gray.600.Brush}"/>
                    <TextBlock Grid.Column="1" Text="Ваше преимущество РЕХАУ" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="©" Foreground="{DynamicResource Brand.Gray.600.Brush}"/>
                    <TextBlock Grid.Column="1" Text="РЕХАУ" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>

            <Button Content="Закрыть"
                    Style="{StaticResource Button.Secondary}"
                    Click="CloseButton_Click"
                    MinWidth="110"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"/>
        </StackPanel>
    </StackPanel>
</Window>
