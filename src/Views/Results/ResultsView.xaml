<UserControl x:Class="SnowMeltingCalculator.Views.Results.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Results"
             xmlns:ap="clr-namespace:SnowMeltingCalculator.AttachedProperties"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:shared="clr-namespace:SnowMeltingCalculator.Views.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource RehauBackgroundBrush}">

    <UserControl.Resources>
        <!-- Конвертер: литры в час → м³/ч -->
        <converters:DivisionConverter x:Key="LitersToCubicMetersConverter" Divisor="1000"/>

        <!-- Конвертер: Па → кПа -->
        <converters:DivisionConverter x:Key="PascalToKilopascalConverter" Divisor="1000"/>

        <!-- ===== Фаза 6 редизайна: дашборд по эталону renders/02 =====
             HeroKPI «Тепловая мощность» (единственный градиентный акцент
             экрана) + BrandFrame готовности + 6 KPI-чипов (маппинг 8→6:
             «Тепловая мощность» ушла в HeroKPI, «Рабочая» — на ThermalView
             и в отчётах). Номер проекта/объект — в шапке каркаса, статус —
             в статус-баре, экспорт — сплит-кнопка «Отчёт PDF» в шапке.

             Урок №6 (docs/agents/lessons.md): вьюха скроллится, поэтому
             высота чипов фиксированная (AspectRatio.Ratio=0), а карточки
             коллекторов — контентной высоты БЕЗ переносов строк: высота
             не должна зависеть от ширины вьюпорта. -->

        <!-- Чип KPI дашборда: фиксированная высота вместо 2:1
             (петля «скроллбар ↔ перекомпоновка», см. Thv.ResultChip Ф5) -->
        <Style x:Key="Rsv.Chip" TargetType="Border" BasedOn="{StaticResource KpiChip.Root}">
            <Setter Property="ap:AspectRatio.Ratio" Value="0"/>
            <Setter Property="Height" Value="96"/>
        </Style>

        <!-- Внутренняя плитка: карточка коллектора / пункт оборудования -->
        <Style x:Key="Rsv.InnerCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}"/>
            <Setter Property="Padding" Value="{StaticResource Spacing.SM.Thickness}"/>
        </Style>

        <!-- Строка «метка — значение — единица» (эталон .info-rows) -->
        <Style x:Key="Rsv.InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style x:Key="Rsv.InfoRowLabel" TargetType="TextBlock" BasedOn="{StaticResource Card.Subtitle}"/>

        <Style x:Key="Rsv.InfoRowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="Rsv.InfoRowUnit" TargetType="TextBlock" BasedOn="{StaticResource Card.Subtitle}">
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <!-- Заголовок подсекции внутри карточки (эталон .info-rows групп) -->
        <Style x:Key="Rsv.GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Заголовок карточки коллектора -->
        <Style x:Key="Rsv.CollectorTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Caption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
        </Style>

        <!-- Плашка готовности к отчёту (BrandFrame): тексты переключаются
             состоянием IsDataReady триггерами стиля — без VM-интерполяций -->
        <Style x:Key="Rsv.ReadinessTitle" TargetType="TextBlock" BasedOn="{StaticResource BrandFrame.Title}">
            <Setter Property="Text" Value="Проект готов к формированию отчёта"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDataReady}" Value="False">
                    <Setter Property="Text" Value="Проект не готов к формированию отчёта"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Rsv.ReadinessSub" TargetType="TextBlock" BasedOn="{StaticResource BrandFrame.Sub}">
            <!-- Без Wrap: в прокручиваемой вьюхе высота не зависит от ширины
                 (урок №6, ревью Ф6 P3-2); длинный перечень неготовых модулей
                 триммится — он же целиком виден в статус-баре каркаса -->
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Text" Value="Все модули рассчитаны. Экспорт — кнопка «Отчёт PDF» в шапке."/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDataReady}" Value="False">
                    <Setter Property="Text" Value="{Binding StatusMessage}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Вьюха всегда скроллится: каркас статус-бара и шапки не зависит от
         высоты контента; контентная высота секций не участвует в петлях
         компоновки (фиксированные/контентные высоты, см. шапку файла) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="True"
                  PanningMode="VerticalOnly">
        <Grid Margin="{StaticResource Spacing.SM.Thickness}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- ROW 0: HeroKPI + готовность к отчёту         -->
            <!-- ============================================ -->
            <!-- HeroKPI и чипы не гейтятся по IsDataReady: на чистом старте
                 показывают нули — якорь UiSmoke (ResultsThermalPower) и
                 осмысленное «пустое состояние» дашборда -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- HeroKPI: тепловая мощность системы (градиент Red.Intensive,
                     белая цифра, фирменные «квадраты» — tokens.css .hero/.squares) -->
                <Border Grid.Column="0" Style="{StaticResource HeroKpi.Root}" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ТЕПЛОВАЯ МОЩНОСТЬ СИСТЕМЫ" Style="{StaticResource HeroKpi.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalThermalPower_kW, StringFormat={}{0:F1}}"
                                           Style="{StaticResource HeroKpi.Value}"
                                           AutomationProperties.AutomationId="ResultsThermalPower"/>
                                <TextBlock Text="кВт" Style="{StaticResource HeroKpi.Unit}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HeroKpi.Detail}">
                                <Run Text="Режим: "/>
                                <Run Text="{Binding CurrentModeText, Mode=OneWay}"/>
                                <Run Text=" · Тпод "/>
                                <Run Text="{Binding SupplyTemperature, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" °C · q "/>
                                <Run Text="{Binding TotalPowerDensity, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" Вт/м²"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Декор «квадраты»: (0,0) Red.Pale, (0,2) White, (1,1) Teal.Soft -->
                        <Grid Width="50" Height="32"
                              HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Brand.Red.Pale.Brush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Brand.White.Brush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Brand.Teal.Soft.Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Готовность к формированию отчёта: BrandFrame (рамка
                     ключевого сообщения); !IsDataReady — перечень неготовых
                     модулей приходит в StatusMessage -->
                <Border Grid.Column="1" Style="{StaticResource BrandFrame.Root}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Rsv.ReadinessTitle}"/>
                        <TextBlock Style="{StaticResource Rsv.ReadinessSub}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- ROW 1: 6 KPI-чипов (один ряд; читаемость     -->
            <!-- ≥1280: ~166 px на чип, сводка скрыта <1680)  -->
            <!-- ============================================ -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Rsv.Chip}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SystemVolume_L, StringFormat={}{0:F0}}" Style="{StaticResource KpiChip.Value}"/>
                            <TextBlock Text="л" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Объём системы" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Rsv.Chip}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PumpFlowRate_m3h, StringFormat={}{0:F2}}" Style="{StaticResource KpiChip.Value}"/>
                            <TextBlock Text="м³/ч" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Расход насоса" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Rsv.Chip}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PumpHead_kPa, StringFormat={}{0:F0}}" Style="{StaticResource KpiChip.Value}"/>
                            <TextBlock Text="кПа" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Напор насоса" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Rsv.Chip}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SupplyTemperature, StringFormat={}{0:F1}}"
                                       Style="{StaticResource KpiChip.ValueAccent}"
                                       AutomationProperties.AutomationId="ResultsSupplyTemperature"/>
                            <TextBlock Text="°C" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Подача" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Rsv.Chip}" Margin="0,0,10,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ReturnTemperature, StringFormat={}{0:F1}}"
                                       Style="{StaticResource KpiChip.ValueTeal}"
                                       AutomationProperties.AutomationId="ResultsReturnTemperature"/>
                            <TextBlock Text="°C" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Обратка" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Style="{StaticResource Rsv.Chip}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExpansionTankVolume_L, StringFormat={}{0:F0}}" Style="{StaticResource KpiChip.Value}"/>
                            <TextBlock Text="л" Style="{StaticResource KpiChip.Unit}"/>
                        </StackPanel>
                        <TextBlock Text="Расширительный бак" Style="{StaticResource KpiChip.Label}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- ROW 2: Гидравлика по коллекторам + Оборудование -->
            <!-- ============================================ -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Гидравлика по коллекторам -->
                <Border Grid.Column="0" Style="{StaticResource Card.Root}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Гидравлика по коллекторам" Style="{StaticResource Card.Title}"/>

                        <!-- Карточки коллекторов: контентная высота, строки БЕЗ
                             переносов — высота не зависит от ширины (урок №6) -->
                        <ItemsControl ItemsSource="{Binding HydraulicSummaryCards}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HydraulicSummaryCards.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Rsv.InnerCard}" Margin="0,0,10,10">
                                        <StackPanel>
                                            <!-- Заголовок: номер + тип коллектора -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Коллектор №" Style="{StaticResource Rsv.InfoRowLabel}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CollectorNumber}"
                                                           Style="{StaticResource Rsv.CollectorTitle}"
                                                           Margin="4,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CollectorTypeDisplay}"
                                                           Style="{StaticResource Rsv.InfoRowLabel}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Левая колонка: параметры -->
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Контуров" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CircuitCount, StringFormat={}{0} шт.}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                                    </Grid>
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Длина труб" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TotalPipeLength, StringFormat={}{0:F1} м}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                                    </Grid>
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Мощность" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TotalPower, StringFormat={}{0:F0} Вт}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                                    </Grid>
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Kv" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kv, StringFormat={}{0:F2}}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Правая колонка: гидравлика -->
                                                <StackPanel Grid.Column="1">
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Расход" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Rsv.InfoRowValue}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F2} м³/ч">
                                                                    <Binding Path="TotalFlowRate" Converter="{StaticResource LitersToCubicMetersConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Потери (раб.)" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Brand.Teal.Deep.Brush}" Style="{StaticResource Rsv.InfoRowValue}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F1} кПа">
                                                                    <Binding Path="OperatingPressureLossPa" Converter="{StaticResource PascalToKilopascalConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                    <Grid Style="{StaticResource Rsv.InfoRow}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Потери (хол.)" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Brand.Red.Brush}" Style="{StaticResource Rsv.InfoRowValue}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0:F1} кПа">
                                                                    <Binding Path="ColdPressureLossPa" Converter="{StaticResource PascalToKilopascalConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Пустое состояние: нет данных по коллекторам -->
                        <TextBlock Text="Нет данных по коллекторам"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Card.Subtitle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HydraulicSummaryCards.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Оборудование -->
                <Border Grid.Column="1" Style="{StaticResource Card.Root}">
                    <StackPanel>
                        <TextBlock Text="Оборудование" Style="{StaticResource Card.Title}"/>

                        <!-- Коллекторы -->
                        <Border Style="{StaticResource Rsv.InnerCard}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Коллекторы" Style="{StaticResource Rsv.GroupTitle}" Margin="0"/>
                                <ItemsControl ItemsSource="{Binding CollectorEquipmentItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Type}" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CollectorQuantity, StringFormat={}{0} шт}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Трубы -->
                        <Border Style="{StaticResource Rsv.InnerCard}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Трубы" Style="{StaticResource Rsv.GroupTitle}" Margin="0"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PipeType}" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TotalPipeLength, StringFormat='{}{0:F1} м'}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Расширительный бак -->
                        <Border Style="{StaticResource Rsv.InnerCard}" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Расширительный бак" Style="{StaticResource Rsv.GroupTitle}" Margin="0"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Объём" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpansionTankV, StringFormat='{}{0:F1} л'}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Насос -->
                        <Border Style="{StaticResource Rsv.InnerCard}" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Насос" Style="{StaticResource Rsv.GroupTitle}" Margin="0"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Расход Q" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PumpQ, StringFormat='{}{0:F2} м³/ч'}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Напор H" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PumpH, StringFormat='{}{0:F0} кПа'}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- ROW 3: Конструкция + Исходные данные         -->
            <!-- ============================================ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Конструкция: схема (существующий контрол) + ключевые показатели -->
                <Border Grid.Column="0" Style="{StaticResource Card.Root}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Визуализация слоёв (левая часть) -->
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource Brand.Gray.100.Brush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="4"
                                Margin="0,0,10,0">
                            <!-- DataContext вкладки — ResultsViewModel; ConstructionViewModel
                                 берём у MainViewModel (DataContext окна): прямая привязка
                                 к несуществующему свойству тихо падала и схема не рисовалась
                                 (план 2026-09-04, D3). -->
                            <shared:ConstructionVisualizationView DataContext="{Binding DataContext.ConstructionViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CompactMode="True"
                                                                  ShowDimensionLine="True"
                                                                  MaxVisualizationHeight="190"
                                                                  OverflowMode="FixedDepthWindow"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                        </Border>

                        <!-- Ключевые показатели (правая часть) -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ключевые показатели" Style="{StaticResource Card.Title}"/>

                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сопротивление R₁ (над трубой)" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding R1, StringFormat={}{0:F4}}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="м²·К/Вт" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>

                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сопротивление R₂ (под трубой)" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding R2, StringFormat={}{0:F4}}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="м²·К/Вт" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>

                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Эквивалентная теплопроводность λE" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LambdaE, StringFormat={}{0:F3}}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="Вт/(м·К)" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>

                            <Grid Style="{StaticResource Rsv.InfoRow}" Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тепловой поток вверх q↑" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PowerUp, StringFormat={}{0:F1}}"
                                           Foreground="{DynamicResource Brand.Red.Brush}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="Вт/м²" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>

                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тепловой поток вниз q↓" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PowerDown, StringFormat={}{0:F1}}"
                                           Foreground="{DynamicResource Brand.Teal.Deep.Brush}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="Вт/м²" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>

                            <Grid Style="{StaticResource Rsv.InfoRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Суммарный поток q" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalPowerDensity, StringFormat={}{0:F1}}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                <TextBlock Grid.Column="2" Text="Вт/м²" Style="{StaticResource Rsv.InfoRowUnit}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Исходные данные -->
                <Border Grid.Column="1" Style="{StaticResource Card.Root}">
                    <StackPanel>
                        <TextBlock Text="Исходные данные" Style="{StaticResource Card.Title}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Подсекция 1: Климат -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Климат" Style="{StaticResource Rsv.GroupTitle}"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Город" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCity}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Тнар.расч" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DesignTemperature, StringFormat={}{0}°C}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Скорость ветра" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WindSpeed, StringFormat={}{0} м/с}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Снегопад" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SnowfallIntensity, StringFormat={}{0} мм/ч}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Подсекция 2: Труба и укладка -->
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Труба и укладка" Style="{StaticResource Rsv.GroupTitle}"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Тип трубы" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PipeType}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Шаг укладки" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PipeSpacing, StringFormat={}{0} мм}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Темп. грунта" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GroundTemperature, StringFormat={}{0}°C}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Подсекция 3: Режим работы -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Режим работы" Style="{StaticResource Rsv.GroupTitle}"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Режим" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OperatingMode}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Темп. поверхности" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SurfaceTemperature, StringFormat={}{0}°C}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Климат. зона" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClimateZone}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Подсекция 4: Теплоноситель -->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Теплоноситель" Style="{StaticResource Rsv.GroupTitle}"/>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Тип" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GlycolTypeDisplayName}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource Rsv.InfoRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Концентрация" Style="{StaticResource Rsv.InfoRowLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GlycolConcentration, StringFormat={}{0}%}" Style="{StaticResource Rsv.InfoRowValue}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
