<Window x:Class="SnowMeltingCalculator.Views.Construction.MaterialEditorView"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:construction="clr-namespace:SnowMeltingCalculator.Models.Construction"
       mc:Ignorable="d"
       d:DesignHeight="600" d:DesignWidth="780"
       Title="Редактор материалов"
       Height="600" Width="780"
       WindowStartupLocation="CenterOwner"
       Background="{DynamicResource RehauBackgroundBrush}"
       TextElement.Foreground="{DynamicResource RehauBlackBrush}"
       FontFamily="{StaticResource FontFamily.Main}"
       ResizeMode="CanResize"
       MinHeight="500" MinWidth="700">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Редактор материалов"
                   Style="{StaticResource Text.H2}"
                   Foreground="{DynamicResource RehauBlackBrush}"
                   Margin="0,0,0,16"/>

        <!-- Основная область: список + форма -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Список материалов -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource Card.Default}">
                <Grid Margin="{StaticResource Spacing.MD.Thickness}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Материалы"
                               Style="{StaticResource Text.H4}"
                               Foreground="{DynamicResource RehauBlackBrush}"
                               Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Materials}"
                             SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{DynamicResource RehauBlackBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RehauTealLightOpacityBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource RehauRedLightOpacityBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RehauRedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type construction:Material}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" (встроенный)"
                                               FontSize="11"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Форма редактирования -->
            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Card.Default}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                        <TextBlock Text="Параметры материала"
                                   Style="{StaticResource Text.H4}"
                                   Foreground="{DynamicResource RehauBlackBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Сообщение если встроенный материал выбран -->
                        <Border Background="{DynamicResource RehauTealLightOpacityBrush}"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding SelectedMaterial.IsBuiltIn, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Встроенный материал нельзя редактировать или удалять."
                                       Foreground="{DynamicResource RehauTealDarkBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Нет выбранного материала -->
                        <TextBlock Text="Выберите материал из списка или нажмите «Добавить» для создания нового."
                                   Foreground="{DynamicResource RehauGrayBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding EditingMaterial, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <!-- Форма (видна только когда EditingMaterial != null) -->
                        <StackPanel Visibility="{Binding EditingMaterial, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- Название -->
                            <TextBlock Text="Название:"
                                       FontSize="12"
                                       Foreground="{DynamicResource RehauGrayBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingMaterial.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource RehauTextBoxStyle}"
                                     IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"
                                     Margin="0,0,0,12"/>

                            <!-- λА и λБ -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="λА (сухие условия), Вт/м·К:"
                                               FontSize="12"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingMaterial.LambdaA, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                             Style="{StaticResource RehauTextBoxStyle}"
                                             IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="λБ (влажные условия), Вт/м·К:"
                                               FontSize="12"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingMaterial.LambdaB, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                             Style="{StaticResource RehauTextBoxStyle}"
                                             IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Макс. температура подачи и Мин. температура наружного воздуха -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Макс. температура подачи, °C:"
                                               FontSize="12"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingMaterial.MaxSupplyTemp, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, TargetNullValue=''}"
                                             Style="{StaticResource RehauTextBoxStyle}"
                                             IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Мин. температура наружного воздуха, °C:"
                                               FontSize="12"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingMaterial.MinOutdoorTemp, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, TargetNullValue=''}"
                                             Style="{StaticResource RehauTextBoxStyle}"
                                             IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Примечания -->
                            <TextBlock Text="Примечания:"
                                       FontSize="12"
                                       Foreground="{DynamicResource RehauGrayBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingMaterial.Notes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource RehauTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"
                                     IsReadOnly="{Binding CanEditMaterial, Converter={StaticResource InverseBooleanConverter}}"
                                     Margin="0,0,0,12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Сообщение об ошибке -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#FFF8E8"
                BorderBrush="#FFB300"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E65100"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Добавить"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource RehauSecondaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource RehauPrimaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource RehauDeleteButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Закрыть"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource RehauSecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>