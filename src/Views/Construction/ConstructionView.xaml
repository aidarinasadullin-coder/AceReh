<UserControl x:Class="SnowMeltingCalculator.Views.Construction.ConstructionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             xmlns:shared="clr-namespace:SnowMeltingCalculator.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{DynamicResource RehauBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="True"
                  PanningMode="VerticalOnly">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <TextBlock Grid.Row="0"
                       Text="Конструкция"
                       Style="{StaticResource Text.H2}"
                       Foreground="{DynamicResource RehauBlackBrush}"
                       Margin="0,0,0,20"/>

            <!-- Параметры -->
            <Border Grid.Row="1" Style="{StaticResource Card.Default}">
                <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                    <TextBlock Text="Параметры"
                               Style="{StaticResource Text.H3}"
                               Foreground="{DynamicResource RehauBlackBrush}"/>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Уровень грунтовых вод"
                                   FontSize="12"
                                   Foreground="{DynamicResource RehauGrayBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding GroundwaterLevelOptions}"
                                  SelectedItem="{Binding SelectedGroundwaterOption}"
                                  MinWidth="250"
                                  ToolTip="Выбор уровня грунтовых вод влияет на теплопроводность материалов под трубой"
                                  Style="{StaticResource RehauComboBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Валидация модуля переехала в статус-бар каркаса (Фаза 1) -->

            <!-- Шаблон конструкции (Фаза 4, п.2): схема предпросмотра всегда
                 видна в «Пире конструкции», кнопка «Развернуть состав» ушла;
                 админ-действия справочников — меню «⋯» -->
            <Border Grid.Row="2" Style="{StaticResource Card.Default}">
                <Grid Margin="{StaticResource Spacing.MD.Thickness}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Шаблон конструкции"
                               Style="{StaticResource Text.H3}"
                               Foreground="{DynamicResource RehauBlackBrush}"/>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <!-- Админ-действия «Материалы…/Шаблоны…» → меню; кнопка
                             подписана текстом, чтобы справочники были находимы
                             без наведения (решение владельца, 2026-09-05) -->
                        <Button x:Name="TemplatesMenuButton"
                                Style="{StaticResource RehauSecondaryButtonStyle}"
                                ToolTip="Материалы и шаблоны конструкций"
                                Click="TemplatesMenuButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Справочники" VerticalAlignment="Center"/>
                                <Path Data="M0,0 L5,5 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      Width="10" Height="5"
                                      Stretch="None"
                                      Margin="8,2,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Материалы…"
                                              Command="{Binding PlacementTarget.DataContext.OpenMaterialEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Шаблоны…"
                                              Command="{Binding PlacementTarget.DataContext.OpenTemplateEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Применить"
                                Command="{Binding ApplyTemplateCommand}"
                                Style="{StaticResource RehauPrimaryButtonStyle}"
                                IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NullToBoolConverter}}"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Выбор шаблона -->
                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              MinWidth="200"
                              HorizontalAlignment="Left"
                              ToolTip="Выберите шаблон для быстрого создания типовой конструкции"
                              Style="{StaticResource RehauComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource RehauBlackBrush}"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Описание выбранного шаблона -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding SelectedTemplate.Description}"
                               FontSize="12"
                               Foreground="{DynamicResource RehauGrayBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding SelectedTemplate, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <!-- Ошибка предпросмотра/применения шаблона -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="{Binding TemplatePreviewErrorMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource RehauRedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding TemplatePreviewErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Пир конструкции (Фаза 4, п.3): одна широкая карточка — группы
                 «над/под трубой» со своими тулбарами и схема справа
                 (существующий контрол визуализации не меняется, решение
                 владельца п.8); R1/R2/λE переехали в панель «Сводка» (п.4) -->
            <Border Grid.Row="3" Style="{StaticResource Card.Default}">
                <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                    <TextBlock Text="Пир конструкции"
                               Style="{StaticResource Text.H3}"
                               Foreground="{DynamicResource RehauBlackBrush}"
                               Margin="0,0,0,12"/>

                    <Grid x:Name="PieLayoutGrid">
                        <Grid.RowDefinitions>
                            <!-- Row 1 — схема в узком режиме (<880 px, code-behind) -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Таблицы групп -->
                        <StackPanel Grid.Column="0" x:Name="TablesPanel" Margin="0,0,16,0">

                            <!-- Слои над трубой -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Слои над трубой"
                                           Style="{StaticResource Text.BodyBold}"
                                           Foreground="{DynamicResource RehauTealBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalThicknessAbovePipe, StringFormat='общая толщина {0:F0} мм'}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource RehauGrayBrush}"
                                           Margin="12,0,0,0"/>
                                <Button Grid.Column="2"
                                        Content="+ Слой"
                                        Command="{Binding AddLayerAbovePipeCommand}"
                                        Style="{StaticResource RehauSecondaryButtonStyle}"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding LayersAbovePipe}"
                                      SelectedItem="{Binding SelectedLayer}"
                                      Style="{StaticResource DataGrid.Default}"
                                      IsReadOnly="False"
                                      MinHeight="160">
                                <DataGrid.Columns>
                                    <!-- № -->
                                    <DataGridTextColumn Header="№"
                                                        Binding="{Binding Order, Converter={StaticResource OrderToNumberConverter}}"
                                                        Width="40"
                                                        IsReadOnly="True"
                                                        Foreground="{DynamicResource RehauBlackBrush}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Материал -->
                                    <DataGridTemplateColumn Header="Материал" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          MinWidth="150"
                                                          BorderThickness="0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Foreground="{DynamicResource RehauBlackBrush}">
                                                                <Run Text="{Binding Name}"/>
                                                                <Run Text="{Binding Category, StringFormat='({0})'}" Foreground="{DynamicResource RehauGrayBrush}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Толщина -->
                                    <DataGridTemplateColumn Header="Толщина, мм" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F0}}"
                                                         MinWidth="60"
                                                         TextAlignment="Right"
                                                         BorderThickness="0"
                                                         behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                         behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                         behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- λ -->
                                    <DataGridTemplateColumn Header="λ, Вт/м·К" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CalculatedLambda, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                                         MinWidth="60"
                                                         TextAlignment="Right"
                                                         ToolTip="Теплопроводность материала. Можно редактировать вручную."
                                                         BorderThickness="0"
                                                         behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                         behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                         behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- R -->
                                    <DataGridTextColumn Header="R, м²·К/Вт"
                                                        Binding="{Binding CalculatedR, StringFormat={}{0:F4}}"
                                                        Width="100"
                                                        IsReadOnly="True"
                                                        Foreground="{DynamicResource RehauRedBrush}"/>

                                    <!-- Удалить: фикс-ширина — Auto меряется без паддинга ячейки (10+10),
                                         кнопка клипуется при сжатии (Фаза 4В) -->
                                    <DataGridTemplateColumn Header="" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Controls.IconButton.Delete}"
                                                        ToolTip="Удалить слой"
                                                        AutomationProperties.Name="Удалить слой"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Слои под трубой -->
                            <Grid Margin="0,16,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Слои под трубой"
                                           Style="{StaticResource Text.BodyBold}"
                                           Foreground="{DynamicResource RehauTealBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TotalThicknessBelowPipe, StringFormat='общая толщина {0:F0} мм'}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource RehauGrayBrush}"
                                           Margin="12,0,0,0"/>
                                <Button Grid.Column="2"
                                        Content="+ Слой"
                                        Command="{Binding AddLayerBelowPipeCommand}"
                                        Style="{StaticResource RehauSecondaryButtonStyle}"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding LayersBelowPipe}"
                                      SelectedItem="{Binding SelectedLayer}"
                                      Style="{StaticResource DataGrid.Default}"
                                      IsReadOnly="False"
                                      MinHeight="160">
                                <DataGrid.Columns>
                                    <!-- № -->
                                    <DataGridTextColumn Header="№"
                                                        Binding="{Binding Order, Converter={StaticResource OrderToNumberConverter}}"
                                                        Width="40"
                                                        IsReadOnly="True"
                                                        Foreground="{DynamicResource RehauBlackBrush}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Материал -->
                                    <DataGridTemplateColumn Header="Материал" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          MinWidth="150"
                                                          BorderThickness="0">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Foreground="{DynamicResource RehauBlackBrush}">
                                                                <Run Text="{Binding Name}"/>
                                                                <Run Text="{Binding Category, StringFormat='({0})'}" Foreground="{DynamicResource RehauGrayBrush}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Толщина -->
                                    <DataGridTemplateColumn Header="Толщина, мм" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F0}}"
                                                         MinWidth="60"
                                                         TextAlignment="Right"
                                                         BorderThickness="0"
                                                         behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                         behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                         behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- λ -->
                                    <DataGridTemplateColumn Header="λ, Вт/м·К" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CalculatedLambda, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                                         MinWidth="60"
                                                         TextAlignment="Right"
                                                         ToolTip="Теплопроводность материала. При УГВ &lt; 1м используется λБ."
                                                         BorderThickness="0"
                                                         behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                         behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                         behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- R -->
                                    <DataGridTextColumn Header="R, м²·К/Вт"
                                                        Binding="{Binding CalculatedR, StringFormat={}{0:F4}}"
                                                        Width="100"
                                                        IsReadOnly="True"
                                                        Foreground="{DynamicResource RehauRedBrush}"/>

                                    <!-- Удалить: фикс-ширина — Auto меряется без паддинга ячейки (10+10),
                                         кнопка клипуется при сжатии (Фаза 4В) -->
                                    <DataGridTemplateColumn Header="" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Controls.IconButton.Delete}"
                                                        ToolTip="Удалить слой"
                                                        AutomationProperties.Name="Удалить слой"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Схема (существующий контрол визуализации) -->
                        <StackPanel Grid.Column="1" x:Name="SchemaPanel" MinWidth="280">
                            <TextBlock Text="Схема"
                                       Style="{StaticResource Text.BodyBold}"
                                       Foreground="{DynamicResource RehauBlackBrush}"
                                       Margin="0,0,0,8"/>
                            <shared:ConstructionVisualizationView
                                DataContext="{Binding}"
                                MaxVisualizationHeight="300"
                                OverflowMode="FixedDepthWindow"/>
                            <TextBlock Text="{Binding TotalThicknessAbovePipe, StringFormat='Труба на глубине {0:F0} мм'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource RehauGrayBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
