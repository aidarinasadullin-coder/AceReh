<UserControl x:Class="SnowMeltingCalculator.Views.Construction.ConstructionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:construction="clr-namespace:SnowMeltingCalculator.Models.Construction"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             xmlns:shared="clr-namespace:SnowMeltingCalculator.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{DynamicResource RehauBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="True"
                  PanningMode="VerticalOnly">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

<!-- Заголовок страницы -->
        <TextBlock Grid.Row="0"
                   Text="Конструкция"
                   Style="{StaticResource Text.H2}"
                   Foreground="{DynamicResource RehauBlackBrush}"
                   Margin="0,0,0,20"/>

        <!-- Параметры -->
        <Border Grid.Row="1" Style="{StaticResource Card.Default}">
            <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                <TextBlock Text="Параметры"
                          Style="{StaticResource Text.H4}"
                          Foreground="{DynamicResource RehauBlackBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- УГВ -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Уровень грунтовых вод:"
                                   FontSize="12"
                                   Foreground="{DynamicResource RehauGrayBrush}"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding GroundwaterLevelOptions}"
                                 SelectedItem="{Binding SelectedGroundwaterOption}"
                                 MinWidth="250"
                                 ToolTip="Выбор уровня грунтовых вод влияет на теплопроводность материалов под трубой"
                                 Style="{StaticResource RehauComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Нагрузки -->
                    <CheckBox Grid.Column="1"
                             Content="Наличие нагрузок на покрытие"
                             IsChecked="{Binding HasLoads}"
                             Margin="24,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="При наличии нагрузок минимальная толщина слоёв над трубой увеличивается до 50 мм"
                             Foreground="{DynamicResource RehauBlackBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Шаблоны -->
        <Border Grid.Row="2" Style="{StaticResource Card.Default}">
            <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                <TextBlock Text="Шаблоны конструкций"
                          Style="{StaticResource Text.H4}"
                          Foreground="{DynamicResource RehauBlackBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             MinWidth="300"
                             ToolTip="Выберите шаблон для быстрого создания типовой конструкции"
                             Style="{StaticResource RehauComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource RehauBlackBrush}"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource RehauGrayBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                           Content="Применить"
                           Command="{Binding ApplyTemplateCommand}"
                           Style="{StaticResource RehauPrimaryButtonStyle}"
                           Margin="16,0,0,0"
                           IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NullToBoolConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Слои над трубой -->
        <Border Grid.Row="3" Style="{StaticResource Card.Default}">
            <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

<TextBlock Grid.Column="0"
                               Text="Слои над трубой"
                              Style="{StaticResource Text.H4}"
                              Foreground="{DynamicResource RehauBlackBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalThicknessAbovePipe, StringFormat='Общая толщина: {0:F0} мм'}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource RehauTealBrush}"
                                  FontWeight="SemiBold"
                                  Margin="0,0,16,0"/>
                        <Button Content="Добавить слой"
                               Command="{Binding AddLayerAbovePipeCommand}"
                               Style="{StaticResource RehauSecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <DataGrid ItemsSource="{Binding LayersAbovePipe}"
                          SelectedItem="{Binding SelectedLayer}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          MinHeight="160"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource RehauGrayBrush}"
                          RowBackground="{DynamicResource RehauCardBrush}"
                          AlternatingRowBackground="{DynamicResource RehauBackgroundGrayBrush}">
                    <DataGrid.Columns>
                        <!-- № -->
                        <DataGridTextColumn Header="№"
                                          Binding="{Binding Order, Converter={StaticResource OrderToNumberConverter}}"
                                          Width="40"
                                          IsReadOnly="True"
                                          Foreground="{DynamicResource RehauBlackBrush}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Материал -->
                        <DataGridTemplateColumn Header="Материал" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                             SelectedItem="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             MinWidth="150"
                                             BorderThickness="0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{DynamicResource RehauBlackBrush}">
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text="{Binding Category, StringFormat='({0})'}" Foreground="{DynamicResource RehauGrayBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Толщина -->
                        <DataGridTemplateColumn Header="Толщина, мм" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F0}}"
                                            MinWidth="60"
                                            TextAlignment="Right"
                                            BorderThickness="0"
                                            behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                            behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                            behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- λ -->
                        <DataGridTemplateColumn Header="λ, Вт/м·К" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CalculatedLambda, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                            MinWidth="60"
                                            TextAlignment="Right"
                                            ToolTip="Теплопроводность материала. Можно редактировать вручную."
                                            BorderThickness="0"
                                            behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                            behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                            behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- R -->
                        <DataGridTextColumn Header="R, м²·К/Вт"
                                          Binding="{Binding CalculatedR, StringFormat={}{0:F4}}"
                                          Width="100"
                                          IsReadOnly="True"
                                          Foreground="{DynamicResource RehauRedBrush}"/>

                        <!-- Удалить -->
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                           Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource RehauDeleteButtonStyle}"
                                           ToolTip="Удалить слой"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

<!-- Слои под трубой и Визуализация -->
        <Grid Grid.Row="4" x:Name="LayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Слои под трубой -->
            <Border x:Name="LayersBelowCard" Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource Card.Default}">
                <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

<TextBlock Grid.Column="0"
                                   Text="Слои под трубой"
                                  Style="{StaticResource Text.H4}"
                                  Foreground="{DynamicResource RehauBlackBrush}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding TotalThicknessBelowPipe, StringFormat='Общая толщина: {0:F0} мм'}"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource RehauTealBrush}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,16,0"/>
                            <Button Content="Добавить слой"
                                   Command="{Binding AddLayerBelowPipeCommand}"
                                   Style="{StaticResource RehauSecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid ItemsSource="{Binding LayersBelowPipe}"
                              SelectedItem="{Binding SelectedLayer}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              MinHeight="160"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource RehauGrayBrush}"
                              RowBackground="{DynamicResource RehauCardBrush}"
                              AlternatingRowBackground="{DynamicResource RehauBackgroundGrayBrush}">
                        <DataGrid.Columns>
                            <!-- № -->
                            <DataGridTextColumn Header="№"
                                              Binding="{Binding Order, Converter={StaticResource OrderToNumberConverter}}"
                                              Width="40"
                                              IsReadOnly="True"
                                              Foreground="{DynamicResource RehauBlackBrush}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Материал -->
                            <DataGridTemplateColumn Header="Материал" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableMaterials, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding Material, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  MinWidth="150"
                                                  BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Толщина -->
                            <DataGridTemplateColumn Header="Толщина, мм" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Thickness, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F0}}"
                                                MinWidth="60"
                                                TextAlignment="Right"
                                                BorderThickness="0"
                                                behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- λ -->
                            <DataGridTemplateColumn Header="λ, Вт/м·К" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CalculatedLambda, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat={}{0:F3}}"
                                                MinWidth="60"
                                                TextAlignment="Right"
                                                ToolTip="Теплопроводность материала. При УГВ &lt; 1м используется λБ."
                                                BorderThickness="0"
                                                behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                                behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                                behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- R -->
                            <DataGridTextColumn Header="R, м²·К/Вт"
                                              Binding="{Binding CalculatedR, StringFormat={}{0:F4}}"
                                              Width="100"
                                              IsReadOnly="True"
                                              Foreground="{DynamicResource RehauRedBrush}"/>

                            <!-- Удалить -->
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveLayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource RehauDeleteButtonStyle}"
                                                ToolTip="Удалить слой"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Визуализация конструкции -->
            <Border x:Name="VisualizationCard" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Card.Default}">
                <StackPanel Margin="{StaticResource Spacing.MD.Thickness}">
                    <TextBlock Text="Визуализация"
                               Style="{StaticResource Text.H4}"
                               Foreground="{DynamicResource RehauBlackBrush}"
                               Margin="0,0,0,8"/>
                    <shared:ConstructionVisualizationView DataContext="{Binding}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Результаты и Валидация -->
        <Border Grid.Row="5" Margin="0,16,0,0" Style="{StaticResource Card.Default}">
<Grid Margin="{StaticResource Spacing.LG.Thickness}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Результаты расчёта -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Результаты расчёта"
                              Style="{StaticResource Text.H4}"
                              Foreground="{DynamicResource RehauBlackBrush}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- R1 -->
                        <Border Grid.Column="0" Margin="0,0,24,0"
                               Background="{DynamicResource RehauResultCardBrush}"
                               Padding="16,12"
                               CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="R₁ (над трубой):" Foreground="{DynamicResource RehauGrayBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding R1Total, StringFormat='{}{0:F4} м²·К/Вт'}"
                                          FontWeight="Bold"
                                          FontSize="18"
                                          Foreground="{DynamicResource RehauRedBrush}"
                                          FontFamily="{StaticResource FontFamily.Main}"/>
                            </StackPanel>
                        </Border>

                        <!-- R2 -->
                        <Border Grid.Column="1" Margin="0,0,24,0"
                               Background="{DynamicResource RehauResultCardBrush}"
                               Padding="16,12"
                               CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="R₂ (под трубой):" Foreground="{DynamicResource RehauGrayBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding R2Total, StringFormat='{}{0:F4} м²·К/Вт'}"
                                          FontWeight="Bold"
                                          FontSize="18"
                                          Foreground="{DynamicResource RehauRedBrush}"
                                          FontFamily="{StaticResource FontFamily.Main}"/>
                            </StackPanel>
                        </Border>

                        <!-- LambdaE -->
                        <Border Grid.Column="2"
                               Background="{DynamicResource RehauResultCardBrush}"
                               Padding="16,12"
                               CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="λE (вокруг трубы):" Foreground="{DynamicResource RehauGrayBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding LambdaE, StringFormat='{}{0:F3} Вт/м·К'}"
                                          FontWeight="Bold"
                                          FontSize="18"
                                          Foreground="{DynamicResource RehauTealBrush}"
                                          FontFamily="{StaticResource FontFamily.Main}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Сбросить"
                           Command="{Binding ResetToDefaultCommand}"
                           Style="{StaticResource RehauSecondaryButtonStyle}"
                           Margin="0,0,12,0"/>
                    <Button Content="Сохранить"
                           Command="{Binding SaveConstructionCommand}"
                           Style="{StaticResource RehauPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Валидация -->
        <Border Grid.Row="6" Margin="0,16,0,0"
                Style="{StaticResource Card.Default}"
                Background="#FFF8E8"
                BorderBrush="#FFB300"
                BorderThickness="1"
                Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Margin="16">
                <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                      Width="20" Height="20"
                      Fill="#FF9800"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Stretch="Uniform"/>
                <TextBlock Text="{Binding ValidationMessage}"
                          VerticalAlignment="Center"
                          TextWrapping="Wrap"
                          Foreground="{Binding IsValid, Converter={StaticResource BoolToValidationColorConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>