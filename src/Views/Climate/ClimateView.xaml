<UserControl x:Class="SnowMeltingCalculator.Views.Climate.ClimateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:SnowMeltingCalculator.Models.Climate"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Климатические данные"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource MaterialDesignBody}"/>

        <!-- Выбор города -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Выбор города"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,8"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                             ItemsSource="{Binding FilteredCities}"
                             SelectedItem="{Binding SelectedCity}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             IsEditable="True"
                             StaysOpenOnEdit="True"
                             MinWidth="300"
                             ToolTip="Выберите город из списка или начните вводить название">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Region}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                           Content="Сбросить"
                           Command="{Binding ResetToDefaultsCommand}"
                           Margin="8,0,0,0"
                           Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Grid>

                <!-- Информация о выбранном городе -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                           Visibility="{Binding SelectedCity, Converter={StaticResource NullToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="MapMarker" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding SelectedCity.DisplayName}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Параметры -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Климатические параметры"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,16"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Температура -->
                    <TextBox Grid.Row="0" Grid.Column="0"
                            Text="{Binding AirTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Температура наружного воздуха:"
                            materialDesign:TextFieldAssist.SuffixText="°C"
                            Margin="0,0,8,8"
                            ToolTip="Расчётная температура наружного воздуха (от -50 до +10°C)">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Ветер -->
                    <TextBox Grid.Row="0" Grid.Column="1"
                            Text="{Binding WindSpeed, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Скорость ветра:"
                            materialDesign:TextFieldAssist.SuffixText="м/с"
                            Margin="8,0,0,8"
                            ToolTip="Скорость ветра в январе (от 0.1 до 30 м/с)"/>

                    <!-- Влажность -->
                    <TextBox Grid.Row="1" Grid.Column="0"
                            Text="{Binding Humidity, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Влажность воздуха:"
                            materialDesign:TextFieldAssist.SuffixText="%"
                            Margin="0,0,8,8"
                            ToolTip="Относительная влажность (от 20 до 100%)"/>

                    <!-- Интенсивность снегопада -->
                    <TextBox Grid.Row="1" Grid.Column="1"
                            Text="{Binding SnowfallIntensity, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Интенсивность снегопада:"
                            materialDesign:TextFieldAssist.SuffixText="см/ч"
                            Margin="8,0,0,8"
                            ToolTip="Интенсивность снегопада (от 0 до 5 см/ч). Типичные значения: 0.2-0.5 см/ч"/>

                    <!-- Зона -->
                    <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             ItemsSource="{Binding Source={StaticResource ClimateZoneValues}}"
                             SelectedItem="{Binding SelectedZone}"
                             materialDesign:TextFieldAssist.PrefixText="Климатическая зона:"
                             Margin="0,0,0,8"
                             ToolTip="Климатическая зона для выбора мощности системы"/>

                    <!-- Повышенные требования -->
                    <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                             Content="Повышенные требования (колонка -20°C)"
                             IsChecked="{Binding IsHighRequirements}"
                             Margin="0,8,0,0"
                             ToolTip="Принудительно использовать колонку -20°C для расчёта мощности"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Информация о зоне -->
        <materialDesign:Card Grid.Row="3" Margin="0,0,0,16"
                            Visibility="{Binding SelectedCity, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Margin="16">
                <materialDesign:PackIcon Kind="Information"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock Text="{Binding ZoneDescription}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBody}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Предупреждения -->
        <materialDesign:Card Grid.Row="4" Margin="0,0,0,16"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Margin="16">
                <materialDesign:PackIcon Kind="Alert"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Foreground="Orange"/>
                <TextBlock Text="{Binding ValidationMessage}"
                          VerticalAlignment="Center"
                          Foreground="Orange"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сбросить к данным города"
                   Command="{Binding ResetToCityDataCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Margin="0,0,8,0"
                   Visibility="{Binding SelectedCity, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>