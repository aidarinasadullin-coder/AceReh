<UserControl x:Class="SnowMeltingCalculator.Views.Climate.ClimateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Climate"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:ap="clr-namespace:SnowMeltingCalculator.AttachedProperties"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             xmlns:controls="clr-namespace:SnowMeltingCalculator.Controls.Climate"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ClimateViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource RehauBackgroundBrush}">

    <!--
        Фаза 5 редизайна (эталон docs/design/renders/01-shell-climate.png):
        одна форм-карточка «Город и климатические параметры» — город (выбор
        завершается в дропдауне, повторной строки города нет), 2×2 поля,
        чекбокс повышенных требований; «пятидневка»/зона — приглушённые
        строки. План 2026-09-12 (часть B): выпадающий список зоны удалён —
        зона выводится из итоговой температуры (приглушённая строка),
        чекбокс — ступень вниз от автоматики города. Обе кнопки сброса
        сохраняются (разные операции) — в заголовке карточки. Валидация —
        статус-бар каркаса (Фаза 1).
    -->
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="True"
                  PanningMode="VerticalOnly">
        <Grid Margin="{StaticResource Spacing.SM.Thickness}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Климатические параметры" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Шаг 1 из 5 — исходные данные для всех расчётов"
                           Style="{StaticResource Card.Subtitle}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Карточка «Данные проекта» (ADR-015, план 2026-09-17):
                 возврат редактирования номера/объекта, удалённого с Ф6.
                 Опциональные поля, на расчёт не влияют; биндинг LostFocus —
                 без эха на каждый символ (ревью R-2026-09-17-01, №6).
                 Владелец значений — ProjectSession, pass-through ClimateVM. -->
            <Border Grid.Row="1" Style="{StaticResource FormCard.Root}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Данные проекта"
                               Style="{StaticResource Card.Title}" Margin="0,0,0,2"/>
                    <TextBlock Text="Опционально · попадают в шапку приложения, пояснительную записку и отчёты"
                               Style="{StaticResource FormCard.Hint}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Номер проекта" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     MaxLength="100"
                                     Text="{Binding ProjectNumber, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Например, 2026-014"
                                     AutomationProperties.AutomationId="ClimateProjectNumber"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Объект" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     MaxLength="200"
                                     Text="{Binding ProjectObject, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Например, парковка у ТЦ, Москва"
                                     AutomationProperties.AutomationId="ClimateProjectObject"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Форм-карточка «Город и климатические параметры» (Ф5.2) -->
            <Border Grid.Row="2" Style="{StaticResource FormCard.Root}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Город и климатические параметры"
                                   Style="{StaticResource Card.Title}" Margin="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Сбросить"
                                    Command="{Binding ResetToDefaultsCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    ToolTip="Очистить выбор города и вернуть параметры к значениям по умолчанию"
                                    AutomationProperties.AutomationId="ClimateReset"/>
                            <Button Content="Сбросить к данным города"
                                    Command="{Binding ResetToCityDataCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="8,0,0,0"
                                    ToolTip="Вернуть параметры к значениям выбранного города"
                                    AutomationProperties.AutomationId="ClimateResetToCity"
                                    Visibility="{Binding SelectedCity, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Город. Выбор города завершается в дропдауне
                         (клик = выбор и закрытие, Ф5.2). Климатическая зона
                         выводится автоматически (приглушённая строка ниже) -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Город" Style="{StaticResource FormCard.Label}"/>
                        <controls:CityAutoCompleteBox
                            AutomationProperties.AutomationId="ClimateCitySearch"
                            SearchQuery="{Binding SearchQuery, Mode=TwoWay}"
                            SelectedCity="{Binding SelectedCity, Mode=TwoWay}"
                            FilteredCities="{Binding FilteredCitiesWithHighlight, Mode=OneWay}"
                            PlaceholderText="Введите город..."
                            ToolTip="Введите название города для поиска"/>
                    </StackPanel>

                    <!-- 2×2: температура / ветер / влажность / снегопад -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Расчётная температура" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Text="{Binding AirTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Расчётная температура наружного воздуха по таблице 1.6 (от -50 до +10°C)"
                                     AutomationProperties.AutomationId="ClimateAirTemperature"
                                     ap:Field.Unit="°C"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Default}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Status.Error.Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Скорость ветра" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     Text="{Binding WindSpeed, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Максимальная из средних скоростей ветра по румбам за январь (от 0.1 до 30 м/с); подставляется из климатической базы при выборе города"
                                     AutomationProperties.AutomationId="ClimateWindSpeed"
                                     ap:Field.Unit="м/с"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Влажность воздуха" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     Text="{Binding Humidity, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Относительная влажность (от 20 до 100%)"
                                     AutomationProperties.AutomationId="ClimateHumidity"
                                     ap:Field.Unit="%"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Интенсивность снегопада (в водном эквиваленте)" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     Text="{Binding SnowfallIntensity, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Интенсивность снегопада (от 0 до 20 мм/ч). Водяной эквивалент."
                                     AutomationProperties.AutomationId="ClimateSnowfallIntensity"
                                     ap:Field.Unit="мм/ч"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                            <TextBlock Text="1 мм/ч воды ≈ 1 см/ч снега (для свежего снега)"
                                       Style="{StaticResource FormCard.Hint}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Повышенные требования: ступень вниз от автоматики города
                         (−10 → −15, −15 → −20); при автоматике −20 или без
                         выбранного города — неактивен; сбрасывается при смене
                         города (план 2026-09-12, часть B) -->
                    <CheckBox Content="Повышенные требования (ступень вниз: −10 → −15, −15 → −20)"
                              IsChecked="{Binding IsHighRequirements}"
                              IsEnabled="{Binding IsHighRequirementsEnabled}"
                              Margin="0,12,0,0"
                              ToolTip="Применить следующую, более холодную колонку таблицы мощности поверх данных города. Сбрасывается при смене города. При расчётной температуре −20 °C недоступен."
                              AutomationProperties.AutomationId="ClimateHighRequirements"/>

                    <!-- Приглушённые строки: «пятидневка» (по городу) и зона -->
                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding IsCitySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Температура холодной пятидневки (СП 131.13330.2025)"
                                   Style="{StaticResource InfoBlock.RowLabel}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource InfoBlock.RowValue}">
                            <Run Text="{Binding ColdFiveDayTemperature, Mode=OneWay, StringFormat={}{0:F1}}"/>
                            <Run Text=" °C"/>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Зона:" Style="{StaticResource InfoBlock.RowLabel}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ZoneDescription}"
                                   Style="{StaticResource InfoBlock.RowValue}"
                                   HorizontalAlignment="Left"
                                   Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
