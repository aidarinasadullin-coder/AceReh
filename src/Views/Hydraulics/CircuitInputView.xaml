<UserControl x:Class="SnowMeltingCalculator.Views.Hydraulics.CircuitInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Hydraulics"
             xmlns:models="clr-namespace:SnowMeltingCalculator.Models.Hydraulics"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="500"
             d:DataContext="{d:DesignInstance Type=models:CircuitRow}">

    <UserControl.Resources>
        <!-- Конвертеры -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- ============================================ -->
        <!-- REHAU СТИЛИ (используем стили из Dictionary.xaml) -->
        <!-- ============================================ -->

        <!-- Стиль для единиц измерения -->
        <Style x:Key="UnitLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource RehauGrayBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Main}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<!-- Заголовок контура -->
        <Border Grid.Row="0"
                Background="{DynamicResource RehauRedLightOpacityBrush}"
                Padding="10,5"
                CornerRadius="{StaticResource Radius.SM}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CircuitNumber, StringFormat='Контур {0}'}"
                           Style="{StaticResource Text.H4}"
                           VerticalAlignment="Center"/>

                <TextBox Grid.Column="1"
                          Text="{Binding CircuitName, UpdateSourceTrigger=PropertyChanged}"
                          Margin="10,0"
                          VerticalAlignment="Center"
                          Width="200"
                          Height="26"
                          VerticalContentAlignment="Center"
                          Style="{StaticResource TextBox.Default}"/>

                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding DataContext.RemoveCircuitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        Style="{StaticResource RehauDeleteButtonStyle}"
                        ToolTip="Удалить контур"
                        Visibility="{Binding IsReferenceCircuit, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Параметры контура -->
        <Border Grid.Row="1"
                Style="{StaticResource Card.Default}"
                CornerRadius="0,0,{StaticResource Radius.SM},{StaticResource Radius.SM}">
            <StackPanel>

                <!-- Основные параметры -->
                <TextBlock Text="Основные параметры" Style="{StaticResource Text.H4}"
                           Foreground="{DynamicResource RehauRedDarkBrush}"
                           Margin="0,0,0,10"/>

<Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Длина контура (L_HK):"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBox Grid.Column="1"
                              Text="{Binding Length, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                              Width="100"
                              Height="26"
                              VerticalContentAlignment="Center"
                              Margin="0,2"
                              Padding="5,0"
                              behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                              behaviors:TextBoxBehavior.RestoreOnEscape="True"
                              behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"
                              Style="{StaticResource TextBox.Default}"/>
                    <TextBlock Grid.Column="2" Text="м" Style="{StaticResource UnitLabelStyle}"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Длина подводки (L_Zul):"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBox Grid.Column="1"
                              Text="{Binding SupplyLength, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                              Width="100"
                              Height="26"
                              VerticalContentAlignment="Center"
                              Margin="0,2"
                              Padding="5,0"
                              behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                              behaviors:TextBoxBehavior.RestoreOnEscape="True"
                              behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"
                              Style="{StaticResource TextBox.Default}"/>
                    <TextBlock Grid.Column="2" Text="м" Style="{StaticResource UnitLabelStyle}"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Площадь контура:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBox Grid.Column="1"
                              Text="{Binding Area, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                              Width="100"
                              Height="26"
                              VerticalContentAlignment="Center"
                              Margin="0,2"
                              Padding="5,0"
                              behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                              behaviors:TextBoxBehavior.RestoreOnEscape="True"
                              behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"
                              Style="{StaticResource TextBox.Default}"/>
                    <TextBlock Grid.Column="2" Text="м²" Style="{StaticResource UnitLabelStyle}"/>
                </Grid>

                <!-- Результаты расчёта -->
                <TextBlock Text="Результаты расчёта"
                           Style="{StaticResource Text.H4}"
                           Foreground="{DynamicResource RehauRedDarkBrush}"
                           Margin="0,15,0,10"/>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Расход:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FlowRate, StringFormat={}{0:F1} л/ч}"
                               Style="{StaticResource Text.BodyBold}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Потери давления:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PressureLossKPa, StringFormat={}{0:F2} кПа}"
                               Style="{StaticResource Text.BodyBold}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Скорость:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Velocity, StringFormat={}{0:F3} м/с}"
                               Style="{StaticResource Text.BodyBold}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Режим течения:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FlowRegime}"
                               Style="{StaticResource Text.BodyBold}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Балансировка -->
                <TextBlock Text="Балансировка"
                           Style="{StaticResource Text.H4}"
                           Foreground="{DynamicResource RehauRedDarkBrush}"
                           Margin="0,15,0,10"/>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Дросселирование:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
<TextBlock Grid.Column="1"
                                Text="{Binding ThrottlingMbar, StringFormat={}{0:F1} мбар}"
                                Style="{StaticResource Text.BodyBold}"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource RehauRedLightBrush}"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Настройка вентиля:"
                               Style="{StaticResource Text.Body}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Width="140"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ValveSetting, StringFormat='Позиция {0}'}"
                               Style="{StaticResource Text.BodyBold}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Статус -->
                <Border Style="{StaticResource RehauSuccessBlockStyle}"
                        Padding="10,5"
                        Margin="0,15,0,0"
                        Visibility="{Binding IsReferenceCircuit, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="★ Опорный контур"
                               Foreground="{DynamicResource RehauTealDarkBrush}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Style="{StaticResource RehauWarningBlockStyle}"
                        Padding="10,5"
                        Margin="0,10,0,0">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource RehauRedDarkBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>