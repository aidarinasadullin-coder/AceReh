<UserControl x:Class="SnowMeltingCalculator.Views.Hydraulics.CircuitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Hydraulics"
             xmlns:models="clr-namespace:SnowMeltingCalculator.Models.Hydraulics"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:CircuitsViewModel}">

    <UserControl.Resources>
        <!-- Конвертеры -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>

        <!-- Конвертер для HydraulicMode -->
        <converters:HydraulicModeToVisibilityConverter x:Key="HydraulicModeToVisibilityConverter"/>

        <!-- Конвертер для цветовой индикации давления -->
        <converters:PressureColorConverter x:Key="PressureColorConverter"/>

        <!-- Конвертеры для табло режима расчёта -->
        <converters:ModeToBackgroundConverter x:Key="ModeToBackgroundConverter"/>
        <converters:ModeToBorderConverter x:Key="ModeToBorderConverter"/>

        <!-- Стили -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="#2196F3"/>
        </Style>

        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="ModeButtonInactiveStyle" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <!-- Стиль для ячеек DataGrid только для чтения -->
        <Style x:Key="ReadOnlyCellStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <!-- Стиль для заголовков DataGrid -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для ячеек с потерями давления в контуре (цветовая индикация) -->
        <Style x:Key="CircuitPressureCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding CurrentResult.CircuitPipeLoss_mbar, Converter={StaticResource PressureColorConverter}}"/>
        </Style>

        <!-- Стиль для ячеек с потерями давления на клапане (цветовая индикация) -->
        <Style x:Key="ValvePressureCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding CurrentResult.ValveLoss_mbar, Converter={StaticResource PressureColorConverter}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Grid.Row="0" — Параметры теплоносителя -->
        <Border Grid.Row="0"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,10"
                CornerRadius="5">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- Тип гликоля -->
                    <TextBlock Text="Тип гликоля:"
                               Style="{StaticResource InputLabelStyle}"
                               VerticalAlignment="Center"/>
                    <ComboBox SelectedValue="{Binding GlycolType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Width="150"
                              Height="26"
                              Margin="0,0,20,0">
                        <ComboBoxItem Content="Этиленгликоль" Tag="{x:Static models:GlycolType.Ethylene}"/>
                        <ComboBoxItem Content="Пропиленгликоль" Tag="{x:Static models:GlycolType.Propylene}"/>
                    </ComboBox>

                    <!-- Концентрация -->
                    <TextBlock Text="Концентрация (%):"
                               Style="{StaticResource InputLabelStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Text="{Binding GlycolConcentration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                             Width="60"
                             Height="26"
                             VerticalContentAlignment="Center"
                             Margin="0,0,20,0"
                             behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                             behaviors:TextBoxBehavior.RestoreOnEscape="True"
                             behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>

                    <!-- Два табло температуры -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundConverter}, ConverterParameter=Operating}"
                                BorderBrush="{Binding CurrentMode, Converter={StaticResource ModeToBorderConverter}, ConverterParameter=Operating}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="10,5"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnOperatingModeClick">
                            <StackPanel>
                                <TextBlock Text="Рабочая температура"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding OperatingTemperatureValue, StringFormat={}{0:F1}°C}"
                                           FontSize="14"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundConverter}, ConverterParameter=Design}"
                                BorderBrush="{Binding CurrentMode, Converter={StaticResource ModeToBorderConverter}, ConverterParameter=Design}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="10,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="OnDesignModeClick">
                            <StackPanel>
                                <TextBlock Text="Расчётная температура"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding DesignTemperatureValue, StringFormat={}{0:F1}°C}"
                                           FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <!-- Шаг подводки -->
                    <TextBlock Text="Шаг подводки (см):"
                               Style="{StaticResource InputLabelStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Text="{Binding InputData.SupplySpacing_cm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                             Width="60"
                             Height="26"
                             VerticalContentAlignment="Center"
                             Margin="0,0,20,0"
                             behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                             behaviors:TextBoxBehavior.RestoreOnEscape="True"
                             behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>

                    <!-- Полезное тепло от подводок -->
                    <TextBlock Text="Полезное тепло от подводок (%):"
                               Style="{StaticResource InputLabelStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Text="{Binding InputData.SupplyHeatPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"
                             Width="60"
                             Height="26"
                             VerticalContentAlignment="Center"
                             Margin="0,0,20,0"
                             behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                             behaviors:TextBoxBehavior.RestoreOnEscape="True"
                             behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid.Row="1" — Свойства теплоносителя -->
        <Border Grid.Row="1"
                Background="#E8F5E9"
                BorderBrush="#4CAF50"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,10"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Свойства теплоносителя"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#2E7D32"
                           Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal">
                    <!-- Рабочая температура -->
                    <StackPanel Margin="0,0,30,0">
                        <TextBlock FontWeight="Bold" Margin="0,0,0,5">
                            <TextBlock.Text>
                                <Binding Path="OperatingGlycolProperties.Temperature" StringFormat="Рабочая температура: {0:F1}°C"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Плотность:" Width="120"/>
                            <TextBlock Text="{Binding OperatingGlycolProperties.Density, StringFormat=F1}"/>
                            <TextBlock Text=" кг/м³" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Теплоёмкость:" Width="120"/>
                            <TextBlock Text="{Binding OperatingGlycolProperties.SpecificHeat, StringFormat=F2}"/>
                            <TextBlock Text=" кДж/(кг·К)" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Вязкость:" Width="120"/>
                            <TextBlock Text="{Binding OperatingGlycolProperties.KinematicViscosity, StringFormat=F2}"/>
                            <TextBlock Text=" мм²/с" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Теплопроводность:" Width="120"/>
                            <TextBlock Text="{Binding OperatingGlycolProperties.ThermalConductivity, StringFormat=F3}"/>
                            <TextBlock Text=" Вт/(м·К)" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Число Прандтля:" Width="120"/>
                            <TextBlock Text="{Binding OperatingGlycolProperties.PrandtlNumber, StringFormat=F2}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Расчётная температура -->
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Margin="0,0,0,5">
                            <TextBlock.Text>
                                <Binding Path="DesignGlycolProperties.Temperature" StringFormat="Расчётная температура: {0:F1}°C"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Плотность:" Width="120"/>
                            <TextBlock Text="{Binding DesignGlycolProperties.Density, StringFormat=F1}"/>
                            <TextBlock Text=" кг/м³" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Теплоёмкость:" Width="120"/>
                            <TextBlock Text="{Binding DesignGlycolProperties.SpecificHeat, StringFormat=F2}"/>
                            <TextBlock Text=" кДж/(кг·К)" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Вязкость:" Width="120"/>
                            <TextBlock Text="{Binding DesignGlycolProperties.KinematicViscosity, StringFormat=F2}"/>
                            <TextBlock Text=" мм²/с" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Теплопроводность:" Width="120"/>
                            <TextBlock Text="{Binding DesignGlycolProperties.ThermalConductivity, StringFormat=F3}"/>
                            <TextBlock Text=" Вт/(м·К)" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Число Прандтля:" Width="120"/>
                            <TextBlock Text="{Binding DesignGlycolProperties.PrandtlNumber, StringFormat=F2}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid.Row="2" — Информационные блоки (Входные данные, Данные укладки, Результаты) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Блок ВХОДНЫЕ ДАННЫЕ (левый блок) -->
            <Border Grid.Column="0"
                    Background="#FFF3E0"
                    BorderBrush="#FF9800"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,5,0"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="ВХОДНЫЕ ДАННЫЕ"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#E65100"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="EINGABEN - Allgemein"
                               FontSize="10"
                               Foreground="#757575"
                               Margin="0,0,0,8"/>

                    <!-- Температура подачи -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="T_подачи:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding SupplyTemperature, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" °C" FontSize="11"/>
                    </StackPanel>

                    <!-- Температура обратки -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="T_обратки:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding ReturnTemperature, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" °C" FontSize="11"/>
                    </StackPanel>

                    <!-- Тип трубы -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Труба:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding PipeType}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   MaxWidth="180"/>
                    </StackPanel>

                    <!-- Наружный диаметр × толщина стенки -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="D_нар:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding OuterDiameter, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text="×" Margin="2,0,2,0" FontSize="11"/>
                        <TextBlock Text="{Binding WallThickness, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" мм" FontSize="11"/>
                    </StackPanel>

                    <!-- Внутренний диаметр -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="D_вн:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding InnerDiameter, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" мм" FontSize="11"/>
                    </StackPanel>

                    <!-- Шероховатость -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="ε:" Width="100" FontSize="11"/>
                        <TextBlock Text="0.007" FontSize="11"/>
                        <TextBlock Text=" мм" FontSize="11"/>
                    </StackPanel>

                    <!-- Тип гликоля -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Гликоль:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding GlycolTypeName}"
                                   FontSize="11"/>
                    </StackPanel>

                    <!-- Концентрация -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Конц.:" Width="100" FontSize="11"/>
                        <TextBlock Text="{Binding GlycolConcentration, StringFormat=F0}"
                                   FontSize="11"/>
                        <TextBlock Text=" %" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Блок ДАННЫЕ УКЛАДКИ И МОЩНОСТИ (центральный блок) -->
            <Border Grid.Column="1"
                    Background="#E8F5E9"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    Padding="10"
                    Margin="5,0,5,0"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="ДАННЫЕ УКЛАДКИ"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#2E7D32"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Verlege- und Leistungsdaten"
                               FontSize="10"
                               Foreground="#757575"
                               Margin="0,0,0,8"/>

                    <!-- Удельная мощность вверх -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="q_вверх:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding PowerUp, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" Вт/м²" FontSize="11"/>
                    </StackPanel>

                    <!-- Удельная мощность вниз -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="q_вниз:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding PowerDown, StringFormat=F1}"
                                   FontSize="11"/>
                        <TextBlock Text=" Вт/м²" FontSize="11"/>
                    </StackPanel>

                    <!-- Шаг укладки -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Шаг:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding PipeSpacing_cm, StringFormat=F0}"
                                   FontSize="11"/>
                        <TextBlock Text=" см" FontSize="11"/>
                    </StackPanel>

                    <!-- Шаг подводки -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Подводка:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SupplySpacing_cm, StringFormat=F0}"
                                   FontSize="11"/>
                        <TextBlock Text=" см" FontSize="11"/>
                    </StackPanel>

                    <!-- Доля потерь -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Потери:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SupplyHeatPercent, StringFormat=F0}"
                                   FontSize="11"/>
                        <TextBlock Text=" %" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Блок РЕЗУЛЬТАТЫ КОЛЛЕКТОРА (правый блок) -->
            <Border Grid.Column="2"
                    Background="#E3F2FD"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    Padding="10"
                    Margin="5,0,0,0"
                    CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="РЕЗУЛЬТАТЫ"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#1565C0"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="ERGEBNISSE - Verteiler"
                               FontSize="10"
                               Foreground="#757575"
                               Margin="0,0,0,8"/>

                    <!-- Количество контуров -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Контуров:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.CircuitCount}" FontSize="11"/>
                        <TextBlock Text=" шт" FontSize="11"/>
                    </StackPanel>

                    <!-- Общая длина -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Длина:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.TotalPipeLength, StringFormat=F1}" FontSize="11"/>
                        <TextBlock Text=" м" FontSize="11"/>
                    </StackPanel>

                    <!-- Общая мощность -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Мощность:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.TotalPower, StringFormat=F1}" FontSize="11"/>
                        <TextBlock Text=" Вт" FontSize="11"/>
                    </StackPanel>

                    <!-- Общий расход -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Расход:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.TotalFlowRate, StringFormat=F1}" FontSize="11"/>
                        <TextBlock Text=" л/ч" FontSize="11"/>
                    </StackPanel>

                    <!-- Потери (рабочая T) -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Δp (раб):" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.PressureLoss_Operating_mbar, StringFormat=F1}"
                                   FontSize="11"
                                   Foreground="{Binding SelectedCollector.Summary.PressureLoss_Operating_mbar, Converter={StaticResource PressureColorConverter}}"/>
                        <TextBlock Text=" мбар" FontSize="11"/>
                    </StackPanel>

                    <!-- Потери (расчётная T) -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Δp (расч):" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.PressureLoss_Cold_mbar, StringFormat=F1}"
                                   FontSize="11"
                                   Foreground="{Binding SelectedCollector.Summary.PressureLoss_Cold_mbar, Converter={StaticResource PressureColorConverter}}"/>
                        <TextBlock Text=" мбар" FontSize="11"/>
                    </StackPanel>

                    <!-- Тип коллектора -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Тип:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.CollectorType}" FontSize="11"/>
                    </StackPanel>

                    <!-- Kv клапана -->
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Kv:" Width="80" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedCollector.Summary.Kv, StringFormat=F2}" FontSize="11"/>
                        <TextBlock Text=" м³/ч" FontSize="11"/>
                    </StackPanel>

                    <!-- Предупреждение о расходе -->
                    <TextBlock Text="{Binding SelectedCollector.Summary.Warning}"
                               Foreground="Red"
                               FontSize="11"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding SelectedCollector.Summary.Warning, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Grid.Row="3" — TabControl для коллекторов -->
        <TabControl Grid.Row="3"
                    ItemsSource="{Binding Collectors}"
                    SelectedIndex="{Binding SelectedCollectorIndex, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding CollectorNumber, StringFormat='Коллектор №{0}'}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Кнопки управления коллекторами -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="+ Добавить коллектор"
                                        Command="{Binding DataContext.AddCollectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        IsEnabled="{Binding DataContext.CanAddCollector, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,10,0"/>

                                <Button Content="- Удалить коллектор"
                                        Command="{Binding DataContext.RemoveCollectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding DataContext.SelectedCollector, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid контуров -->
                        <DataGrid Grid.Row="1"
                                  x:Name="CircuitsDataGrid"
                                  ItemsSource="{Binding Circuits}"
                                  SelectedItem="{Binding DataContext.SelectedCircuit, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  VerticalGridLinesBrush="#E0E0E0"
                                  AlternatingRowBackground="#FAFAFA"
                                  HeadersVisibility="Column"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGrid.Columns>
                                <!-- Номер контура (только чтение) -->
                                <DataGridTextColumn Header="№"
                                                    Binding="{Binding CircuitNumber, Mode=OneWay}"
                                                    IsReadOnly="True"
                                                    Width="50"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Длина контура (редактируется) -->
                                <DataGridTextColumn Header="Длина (м)"
                                                    Binding="{Binding CircuitLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="behaviors:TextBoxBehavior.SelectAllOnFocus" Value="True"/>
                                            <Setter Property="behaviors:TextBoxBehavior.RestoreOnEscape" Value="True"/>
                                            <Setter Property="behaviors:TextBoxBehavior.NormalizeDecimalSeparator" Value="True"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Длина подводки (редактируется) -->
                                <DataGridTextColumn Header="Подводка (м)"
                                                    Binding="{Binding SupplyLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Площадь контура (редактируется) -->
                                <DataGridTextColumn Header="Площадь (м²)"
                                                    Binding="{Binding CircuitArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                            <Setter Property="behaviors:TextBoxBehavior.SelectAllOnFocus" Value="True"/>
                                            <Setter Property="behaviors:TextBoxBehavior.RestoreOnEscape" Value="True"/>
                                            <Setter Property="behaviors:TextBoxBehavior.NormalizeDecimalSeparator" Value="True"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Шаг укладки (только чтение, из вкладки Тепловой расчёт) -->
                                <DataGridTextColumn Header="Шаг (см)"
                                                    Binding="{Binding PipeSpacing_cm, Mode=OneWay, StringFormat=F0}"
                                                    IsReadOnly="True"
                                                    Width="60"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Мощность (только чтение) -->
                                <DataGridTextColumn Header="Мощность (Вт)"
                                                    Binding="{Binding Power, Mode=OneWay, StringFormat=F0}"
                                                    IsReadOnly="True"
                                                    Width="100"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Расход (только чтение) -->
                                <DataGridTextColumn Header="Расход (л/ч)"
                                                    Binding="{Binding FlowRate, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="80"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Скорость (только чтение) -->
                                <DataGridTextColumn Header="Скорость (м/с)"
                                                    Binding="{Binding Velocity, Mode=OneWay, StringFormat=F3}"
                                                    IsReadOnly="True"
                                                    Width="100"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Число Рейнольдса (только чтение) -->
                                <DataGridTextColumn Header="Re"
                                                    Binding="{Binding CurrentResult.ReynoldsNumber, Mode=OneWay, StringFormat=F0}"
                                                    IsReadOnly="True"
                                                    Width="80"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Коэффициент трения λ (только чтение) -->
                                <DataGridTextColumn Binding="{Binding CurrentResult.FrictionFactor, Mode=OneWay, StringFormat=F4}"
                                                    IsReadOnly="True"
                                                    Width="60"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="λ" ToolTip="Коэффициент гидравлического трения"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>

                                <!-- Режим течения (только чтение) -->
                                <DataGridTextColumn Header="Режим"
                                                    Binding="{Binding FlowRegimeDescription, Mode=OneWay}"
                                                    IsReadOnly="True"
                                                    Width="90"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Удельные потери (только чтение) -->
                                <DataGridTextColumn Header="Уд.потери (Па/м)"
                                                    Binding="{Binding CurrentResult.PressureLossPerMeter, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="110"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Потери в контуре (только чтение) -->
                                <DataGridTextColumn Header="Δp контур (мбар)"
                                                    Binding="{Binding CurrentResult.CircuitPipeLoss_mbar, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="120"
                                                    CellStyle="{StaticResource CircuitPressureCellStyle}"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Потери на клапане (только чтение) -->
                                <DataGridTextColumn Header="Δp клапан (мбар)"
                                                    Binding="{Binding CurrentResult.ValveLoss_mbar, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="110"
                                                    CellStyle="{StaticResource ValvePressureCellStyle}"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Суммарные потери (только чтение) -->
                                <DataGridTextColumn Header="Δp сумма (мбар)"
                                                    Binding="{Binding CurrentResult.TotalLoss_mbar, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="110"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>

                                <!-- Обороты вентиля (только чтение) -->
                                <DataGridTextColumn Header="Обороты"
                                                    Binding="{Binding ValveTurns, Mode=OneWay, StringFormat=F1}"
                                                    IsReadOnly="True"
                                                    Width="80"
                                                    ElementStyle="{StaticResource ReadOnlyCellStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопки управления -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,15,0,0">
                            <Button Content="+ Добавить контур"
                                    Command="{Binding DataContext.AddCircuitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.CanAddCircuit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,5,10,5"/>

                            <Button Content="- Удалить контур"
                                    Command="{Binding DataContext.RemoveCircuitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding DataContext.SelectedCircuit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,5,10,5"/>

                            <Button Content="Рассчитать"
                                    Command="{Binding DataContext.CalculateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,5,0,5"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>