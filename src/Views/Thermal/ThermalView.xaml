<UserControl x:Class="SnowMeltingCalculator.Views.Thermal.ThermalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Thermal"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:ap="clr-namespace:SnowMeltingCalculator.AttachedProperties"
             xmlns:behaviors="clr-namespace:SnowMeltingCalculator.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ThermalViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource RehauBackgroundBrush}">

    <!--
        Фаза 5 редизайна (эталон docs/design/renders/04-thermal.png):
        одна форм-карточка «Параметры расчёта» (Режим / Температуры / Труба),
        «Температура поверхности» — отдельное read-only поле по режиму,
        «Рассчитать» перенесена в шапку окна (ThermalCalculate, MainWindow).
        Результаты — HeroKPI + 6 KPI-чипов + свёрнутый блок «Дополнительные
        параметры»; дубль R₁/R₂ убран (панель «Сводка» каркаса, Фаза 4).
        Кнопка «Сбросить» — в заголовке карточки; валидация — статус-бар.
    -->
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Заголовок секции внутри форм-карточки -->
        <Style x:Key="Thv.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brand.Black.Brush}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Read-only поле: hairline-рамка, серый фон, значение + пояснение -->
        <Style x:Key="Thv.ReadOnlyField" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RehauBackgroundGrayBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brand.Gray.100.Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- Чип результатов теплового: фиксированная высота вместо 2:1.
             Высота = ширина/2 (AspectRatio) в прокручиваемой вьюхе создаёт
             петлю «скроллбар ↔ перекомпоновка»: скроллбар сужает вьюпорт →
             чипы ниже → контент помещается → скроллбар скрыт → чипы выше…
             Симптомы: «пляшущая» ширина карточек и вис UI (дефект Ф5).
             Ratio=0 отключает AspectRatio (поддержано в реализации). -->
        <Style x:Key="Thv.ResultChip" TargetType="Border" BasedOn="{StaticResource KpiChip.Root}">
            <Setter Property="ap:AspectRatio.Ratio" Value="0"/>
            <Setter Property="Height" Value="96"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="True"
                  PanningMode="VerticalOnly">
        <Grid Margin="{StaticResource Spacing.SM.Thickness}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Тепловой расчёт" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="Шаг 3 из 5 — режим, температуры, труба"
                           Style="{StaticResource Card.Subtitle}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Форм-карточка «Параметры расчёта» (Ф5.1) -->
            <Border Grid.Row="1" Style="{StaticResource FormCard.Root}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Параметры расчёта"
                                   Style="{StaticResource Card.Title}" Margin="0"/>
                        <Button Grid.Column="1"
                                Content="Сбросить"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource Button.Secondary}"
                                IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBooleanConverter}}"
                                ToolTip="Вернуть параметры теплового расчёта к значениям по умолчанию"
                                AutomationProperties.AutomationId="ThermalReset"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Секция «Режим работы»: подписи режима — как в приложении
                         (OperatingModeDescriptionConverter, +3/+5/+7 °C в описании);
                         условия «ветер/снег» в карточке режима не показываются (Ф5.1) -->
                    <TextBlock Text="Режим работы" Style="{StaticResource Thv.SectionTitle}" Margin="0,8,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding SelectedMode}"
                              ToolTip="Выберите режим работы системы снеготаяния"
                              AutomationProperties.AutomationId="ThermalMode"
                              Style="{StaticResource ComboBox.Field}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="{DynamicResource Brand.Black.Brush}"/>
                                    <TextBlock Style="{StaticResource Card.Subtitle}"
                                               TextWrapping="Wrap"
                                               MaxWidth="450"
                                               Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FormCard.Hint}"
                               Text="{Binding SelectedMode, Converter={StaticResource OperatingModeDescriptionConverter}}"/>

                    <!-- Секция «Температуры»: 2×2 — подача / поверхность (read-only,
                         следует режиму) / перепад (read-only) / грунт -->
                    <TextBlock Text="Температуры" Style="{StaticResource Thv.SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Температура подачи" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     Text="{Binding SupplyTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Температура подачи теплоносителя (от 20°C до 90°C)"
                                     AutomationProperties.AutomationId="ThermalSupplyTemperature"
                                     ap:Field.Unit="°C"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                            <TextBlock Text="{Binding SupplyTemperatureHint}"
                                       Style="{StaticResource FormCard.Hint}"
                                       Foreground="{DynamicResource Brand.Teal.Deep.Brush}"
                                       Visibility="{Binding SupplyTemperatureHint, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Температура поверхности" Style="{StaticResource FormCard.Label}"/>
                            <Border Style="{StaticResource Thv.ReadOnlyField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SurfaceTemperature, StringFormat={}{0:+0.0}°C}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="из режима"
                                               Style="{StaticResource Card.Subtitle}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Температурный перепад" Style="{StaticResource FormCard.Label}"/>
                            <Border Style="{StaticResource Thv.ReadOnlyField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="ThermalDeltaT"
                                               Text="{Binding DeltaT, Mode=OneWay, StringFormat='ΔT {0:F1} K', TargetNullValue='ΔT —', FallbackValue='ΔT —'}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="рассчитывается"
                                               Style="{StaticResource Card.Subtitle}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Температура грунта" Style="{StaticResource FormCard.Label}"/>
                            <TextBox Style="{StaticResource TextBox.Default}"
                                     Text="{Binding GroundTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Температура грунта под системой (от -10°C до +30°C)"
                                     AutomationProperties.AutomationId="ThermalGroundTemperature"
                                     ap:Field.Unit="°C"
                                     behaviors:TextBoxBehavior.SelectAllOnFocus="True"
                                     behaviors:TextBoxBehavior.RestoreOnEscape="True"
                                     behaviors:TextBoxBehavior.NormalizeDecimalSeparator="True"/>
                        </StackPanel>
                    </Grid>

                    <!-- Секция «Труба» -->
                    <TextBlock Text="Труба" Style="{StaticResource Thv.SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Тип трубы" Style="{StaticResource FormCard.Label}"/>
                            <ComboBox ItemsSource="{Binding AvailablePipes}"
                                      SelectedItem="{Binding SelectedPipe}"
                                      ToolTip="Выберите тип трубы RAUTHERM S"
                                      AutomationProperties.AutomationId="ThermalPipe"
                                      Style="{StaticResource ComboBox.Field}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Brand.Black.Brush}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource FormCard.Hint}"
                                       Visibility="{Binding SelectedPipe, Converter={StaticResource NullToVisibilityConverter}}">
                                <Run Text="Наружный Ø "/>
                                <Run Text="{Binding SelectedPipe.OuterDiameter, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" мм · внутренний "/>
                                <Run Text="{Binding SelectedPipe.InnerDiameter, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" мм"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Шаг укладки" Style="{StaticResource FormCard.Label}"/>
                            <ComboBox ItemsSource="{Binding AvailablePipeSpacings}"
                                      SelectedItem="{Binding PipeSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsPipeSpacingEnabled}"
                                      ToolTip="Шаг укладки трубы (выберите из списка)"
                                      AutomationProperties.AutomationId="ThermalPipeSpacing"
                                      Style="{StaticResource ComboBox.Field}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="{DynamicResource Brand.Black.Brush}">
                                            <Run Text="{Binding Mode=OneWay}"/>
                                            <Run Text=" мм"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Результаты: HeroKPI + чипы + свёрнутый справочный блок
                 (видимы после расчёта; R₁/R₂ — в панели «Сводка» каркаса) -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- HeroKPI: суммарная мощность -->
                    <Border Grid.Column="0" Style="{StaticResource HeroKpi.Root}" Margin="0,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Суммарная мощность" Style="{StaticResource HeroKpi.Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Result.PowerTotal, StringFormat={}{0:F1}}"
                                           Style="{StaticResource HeroKpi.Value}"
                                           AutomationProperties.AutomationId="ThermalPowerTotal"/>
                                <TextBlock Text="Вт/м²" Style="{StaticResource HeroKpi.Unit}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PowerSummary}" Style="{StaticResource HeroKpi.Detail}"/>
                        </StackPanel>
                    </Border>

                    <!-- 6 KPI-чипов 3×2 (рендер 04); высота фиксированная —
                          см. Thv.ResultChip про петлю со скроллбаром -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Thv.ResultChip}" Margin="0,0,10,10">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.PowerUp, StringFormat={}{0:F1}}" Style="{StaticResource KpiChip.ValueAccent}"/>
                                    <TextBlock Text="Вт/м²" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Поток вверх q↑" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Thv.ResultChip}" Margin="0,0,10,10">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.PowerDown, StringFormat={}{0:F1}}" Style="{StaticResource KpiChip.ValueTeal}"/>
                                    <TextBlock Text="Вт/м²" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Поток вниз q↓" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Thv.ResultChip}" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.Alpha, StringFormat={}{0:F2}}" Style="{StaticResource KpiChip.Value}"/>
                                    <TextBlock Text="Вт/м²·К" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Коэффициент теплоотдачи α" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Thv.ResultChip}" Margin="0,0,10,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.MeanTemperature, StringFormat={}{0:F1}}" Style="{StaticResource KpiChip.Value}"/>
                                    <TextBlock Text="°C" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Средняя температура" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Thv.ResultChip}" Margin="0,0,10,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.ReturnTemperature, StringFormat={}{0:F1}}" Style="{StaticResource KpiChip.Value}"/>
                                    <TextBlock Text="°C" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Температура обратки" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Thv.ResultChip}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Result.VolumeFlowRate, StringFormat={}{0:F2}}" Style="{StaticResource KpiChip.Value}"/>
                                    <TextBlock Text="л/(ч·м²)" Style="{StaticResource KpiChip.Unit}"/>
                                </StackPanel>
                                <TextBlock Text="Расход" Style="{StaticResource KpiChip.Label}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Дополнительные параметры: свёрнутый справочный блок
                     (данные сохраняются; summary-строка — значения-кратко) -->
                <Expander Style="{StaticResource InfoBlock.Collapsible}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дополнительные параметры" Style="{StaticResource InfoBlock.CollapsibleTitle}"/>
                            <TextBlock Text="{Binding AdditionalSummary}" Style="{StaticResource InfoBlock.CollapsibleSummary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Style="{StaticResource InfoBlock.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Конвективный тепловой поток" Style="{StaticResource InfoBlock.RowLabel}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource InfoBlock.RowValue}">
                                <Run Text="{Binding Result.ConvectionHeat, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" Вт/м²"/>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource InfoBlock.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Полное сопротивление R_FB" Style="{StaticResource InfoBlock.RowLabel}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource InfoBlock.RowValue}">
                                <Run Text="{Binding Result.RFb, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource InfoBlock.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Полное сопротивление R_D" Style="{StaticResource InfoBlock.RowLabel}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource InfoBlock.RowValue}">
                                <Run Text="{Binding Result.RD, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource InfoBlock.Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Массовый расход" Style="{StaticResource InfoBlock.RowLabel}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource InfoBlock.RowValue}">
                                <Run Text="{Binding Result.MassFlowRate, Mode=OneWay, StringFormat={}{0:F2}}"/>
                                <Run Text=" кг/(ч·м²)"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
