<UserControl x:Class="SnowMeltingCalculator.Views.Thermal.ThermalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SnowMeltingCalculator.ViewModels.Thermal"
             xmlns:models="clr-namespace:SnowMeltingCalculator.Models.Thermal"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ThermalViewModel, IsDesignTimeCreatable=False}"
             DataContext="{Binding ThermalViewModel, Source={StaticResource ViewModelLocator}}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Тепловой расчёт"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource MaterialDesignBody}"/>

        <!-- Группа "Режим работы" -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Режим работы"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <ComboBox ItemsSource="{Binding AvailableModes}"
                         SelectedItem="{Binding SelectedMode}"
                         materialDesign:TextFieldAssist.PrefixText="Режим:"
                         MinWidth="300"
                         ToolTip="Выберите режим работы системы снеготаяния">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding}" FontWeight="Bold"/>
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="." Converter="{StaticResource EnumDescriptionConverter}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Описание режима -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <materialDesign:PackIcon Kind="Information"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding SelectedMode, Converter={StaticResource OperatingModeDescriptionConverter}}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Группа "Температуры" -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Температуры"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Температура подачи -->
                    <TextBox Grid.Column="0"
                            Text="{Binding SupplyTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Температура подачи:"
                            materialDesign:TextFieldAssist.SuffixText="°C"
                            Margin="0,0,8,0"
                            ToolTip="Температура подачи теплоносителя (от 20°C до 90°C)">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Температурный перепад -->
                    <TextBox Grid.Column="1"
                            Text="{Binding DeltaT, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Температурный перепад:"
                            materialDesign:TextFieldAssist.SuffixText="К"
                            Margin="0,0,8,0"
                            ToolTip="Температурный перепад между подачей и обраткой (от 5 К до 25 К)"/>

                    <!-- Температура грунта -->
                    <TextBox Grid.Column="2"
                            Text="{Binding GroundTemperature, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Температура грунта:"
                            materialDesign:TextFieldAssist.SuffixText="°C"
                            ToolTip="Температура грунта под системой (от -10°C до +30°C)"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Группа "Труба" -->
        <materialDesign:Card Grid.Row="3" Margin="0,0,0,16">
            <StackPanel Margin="16">
                <TextBlock Text="Труба"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Выбор трубы -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailablePipes}"
                              SelectedItem="{Binding SelectedPipe}"
                              materialDesign:TextFieldAssist.PrefixText="Тип трубы:"
                              Margin="0,0,8,0"
                              ToolTip="Выберите тип трубы RAUTHERM S">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Шаг укладки -->
                    <TextBox Grid.Column="1"
                            Text="{Binding PipeSpacing, StringFormat={}{0:F0}, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:TextFieldAssist.PrefixText="Шаг укладки:"
                            materialDesign:TextFieldAssist.SuffixText="мм"
                            ToolTip="Шаг укладки трубы (от 100 мм до 500 мм)"/>
                </Grid>

                <!-- Информация о выбранной трубе -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                           Visibility="{Binding SelectedPipe, Converter={StaticResource NullToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Pipe"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}"
                              FontSize="12">
                        <Run Text="Наружный диаметр: "/>
                        <Run Text="{Binding SelectedPipe.OuterDiameter, Mode=OneWay}"/>
                        <Run Text=" мм, Внутренний: "/>
                        <Run Text="{Binding SelectedPipe.InnerDiameter, Mode=OneWay}"/>
                        <Run Text=" мм"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
            <Button Content="Рассчитать"
                   Command="{Binding CalculateCommand}"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Margin="0,0,8,0"
                   IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBooleanConverter}}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Calculator"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Рассчитать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Button Content="Сбросить"
                   Command="{Binding ResetCommand}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   IsEnabled="{Binding IsCalculating, Converter={StaticResource InverseBooleanConverter}}">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                            <TextBlock Text="Сбросить" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </StackPanel>

        <!-- Валидация -->
        <materialDesign:Card Grid.Row="5" Margin="0,0,0,16"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Margin="16">
                <materialDesign:PackIcon Kind="Alert"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Foreground="Orange"/>
                <TextBlock Text="{Binding ValidationMessage}"
                          VerticalAlignment="Center"
                          Foreground="Orange"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Группа "Результаты" -->
        <materialDesign:Card Grid.Row="6"
                            Visibility="{Binding Result, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Margin="16">
                <TextBlock Text="Результаты расчёта"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,16"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <!-- Основные результаты -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Коэффициент теплоотдачи α -->
                    <Border Grid.Row="0" Grid.Column="0"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Коэффициент теплоотдачи α"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.Alpha, StringFormat={}{0:F2}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Вт/м²·К"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Мощность вверх q_FB -->
                    <Border Grid.Row="0" Grid.Column="1"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Мощность вверх q_FB"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.PowerUp, StringFormat={}{0:F1}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Вт/м²"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Мощность вниз q_D -->
                    <Border Grid.Row="0" Grid.Column="2"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Мощность вниз q_D"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.PowerDown, StringFormat={}{0:F1}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                            <TextBlock Text="Вт/м²"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Суммарная мощность -->
                    <Border Grid.Row="0" Grid.Column="3"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,0,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Суммарная мощность"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.PowerTotal, StringFormat={}{0:F1}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Вт/м²"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Средняя температура -->
                    <Border Grid.Row="1" Grid.Column="0"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Средняя температура"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.MeanTemperature, StringFormat={}{0:F1}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="°C"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Температура обратки -->
                    <Border Grid.Row="1" Grid.Column="1"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Температура обратки"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.ReturnTemperature, StringFormat={}{0:F1}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="°C"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- Расход -->
                    <Border Grid.Row="1" Grid.Column="2"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,8,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Расход"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.VolumeFlowRate, StringFormat={}{0:F2}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="л/(ч·м²)"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>

                    <!-- КПД ребра -->
                    <Border Grid.Row="1" Grid.Column="3"
                           Background="{DynamicResource MaterialDesignCardBody}"
                           Padding="12"
                           Margin="0,0,0,8"
                           CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="КПД ребра η_R"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock Text="{Binding Result.EfficiencyEtaR, StringFormat={}{0:F3}}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="—"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Дополнительные параметры -->
                <Expander Header="Дополнительные параметры"
                         IsExpanded="False"
                         Background="{DynamicResource MaterialDesignCardBackground}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Теплота плавления -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Теплота плавления снега"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.MeltingHeat, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" Вт/м²"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Лучистый поток -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="Лучистый тепловой поток"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.RadiationHeat, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" Вт/м²"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Конвективный поток -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Конвективный тепловой поток"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.ConvectionHeat, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                <Run Text=" Вт/м²"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Параметр m -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Параметр m"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.ParameterM, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" 1/м"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Сопротивление R1 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="Сопротивление R₁ (над трубой)"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.R1Total, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Сопротивление R2 -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Сопротивление R₂ (под трубой)"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.R2Total, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Полное сопротивление вверх -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Полное сопротивление R_FB"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.RFb, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Полное сопротивление вниз -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Полное сопротивление R_D"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.RD, Mode=OneWay, StringFormat={}{0:F4}}"/>
                                <Run Text=" м²·К/Вт"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Массовый расход -->
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="Массовый расход"
                                      FontSize="11"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <TextBlock FontSize="14">
                                <Run Text="{Binding Result.MassFlowRate, Mode=OneWay, StringFormat={}{0:F2}}"/>
                                <Run Text=" кг/(ч·м²)"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>