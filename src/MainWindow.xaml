<Window x:Class="SnowMeltingCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SnowMeltingCalculator.Views.Climate"
        xmlns:viewsThermal="clr-namespace:SnowMeltingCalculator.Views.Thermal"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Калькулятор снеготаяния РЕХАУ"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Focusable="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header с логотипом РЕХАУ -->
        <materialDesign:ColorZone Grid.Row="0"
                                  Mode="PrimaryMid"
                                  Padding="16,8"
                                  Background="{DynamicResource PrimaryHueMidBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип / Название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="РЕХАУ"
                              Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                              FontWeight="Bold"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                    <TextBlock Text="Калькулятор снеготаяния"
                              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                </StackPanel>

                <!-- Название текущего модуля -->
                <TextBlock Grid.Column="1"
                          Text="Климатические данные"
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="White"/>

                <!-- Информация о проекте -->
                <TextBlock Grid.Column="2"
                          Text="Версия 1.0"
                          Style="{StaticResource MaterialDesignCaptionTextBlock}"
                          VerticalAlignment="Center"
                          Foreground="White"/>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><!-- Боковое меню с автоматической шириной -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню -->
            <Grid Grid.Column="0" x:Name="SidebarGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="65"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <materialDesign:ColorZone Mode="PrimaryLight"
                                          Background="{DynamicResource PrimaryHueLightBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Кнопка сворачивания -->
                        <Button Grid.Row="0"
                                x:Name="ToggleSidebarButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Width="28" Height="28"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarTooltipConverter}}"
                                AutomationProperties.Name="Свернуть/развернуть панель навигации"
                                AutomationProperties.HelpText="Нажмите для переключения состояния боковой панели (Ctrl+B)"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronLeft"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Kind" Value="ChevronRight"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                        <!-- Меню навигации -->
                        <ListBox Grid.Row="1"
                                ItemsSource="{Binding MenuItems}"
                                SelectedItem="{Binding SelectedMenuItem}"
                                Style="{StaticResource MaterialDesignNavigationPrimaryListBox}"
                                Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка -->
                                        <materialDesign:PackIcon Grid.Column="0"
                                                                Kind="{Binding Icon}"
                                                                Width="24" Height="24"
                                                                Margin="4,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                                    <Style.Triggers>
                                                        <!-- Tooltip только в свёрнутом режиме -->
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="ToolTip" Value="{Binding Title}"/>
                                                            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                                                            <Setter Property="ToolTipService.Placement" Value="Right"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <!-- Текст -->
                                        <TextBlock Grid.Column="1"
                                                  Text="{Binding Title}"
                                                  Margin="4,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </materialDesign:ColorZone>
            </Grid>

            <!-- Область контента -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0">
                <ContentControl Content="{Binding CurrentView}"/>
            </ScrollViewer>
        </Grid>
    </Grid>

</Window>