<Window x:Class="SnowMeltingCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900" Width="1440"
        Closing="MainWindow_Closing"
        MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RehauBackgroundBrush}"
        TextElement.Foreground="{DynamicResource Brand.Black.Brush}"
        FontFamily="{StaticResource FontFamily.Main}"
        Focusable="True"
        shell:WindowChrome.WindowChrome="{DynamicResource WindowChrome}">

    <Window.Resources>
        <!-- Стиль для WindowChrome (современный вид окна) -->
        <WindowChrome x:Key="WindowChrome"
                      CaptionHeight="0"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False"/>
    </Window.Resources>

    <!-- Единственный корневой Grid (контракт MainWindowChromeLayoutTests) -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- ШАПКА: светлая поверхность (Фаза 1)          -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                Style="{StaticResource Shell.HeaderRoot}"
                MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип РЕХАУ: цветной знак + кириллический wordmark
                     (logo_main_color.svg SharpVectors рендерит некорректно) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            Background="White"
                            BorderBrush="{DynamicResource Brand.Gray.100.Brush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <svgc:SvgViewbox Source="pack://application:,,,/Assets/Brand/logo_icon_color.svg"
                                         Width="26" Height="26"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="РЕХАУ"
                               FontSize="{StaticResource Font.Size.Title}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brand.Black.Brush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Shell.HeaderDivider}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Калькулятор снеготаяния"
                                   Style="{StaticResource Shell.BrandTitle}"/>
                        <TextBlock Text="открытых площадок"
                                   Style="{StaticResource Shell.BrandSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Текущий модуль -->
                <Border Grid.Column="2" Style="{StaticResource Shell.HeaderDivider}"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentTitle}"
                           Style="{StaticResource Shell.HeaderModuleTitle}"
                           Margin="32,0,16,0"/>

                <!-- Имя проекта (Ф6: постоянное место, read-only; редактирование
                     номера/объекта из UI удалено — поля читаются из .smc).
                     Пустые значения и разделитель скрываются (новый расчёт). -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ResultsViewModel.ProjectNumber}"
                               Style="{StaticResource Shell.ProjectName}"
                               FontWeight="SemiBold"
                               Visibility="{Binding ResultsViewModel.ProjectNumber, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text=" · "
                               Style="{StaticResource Shell.ProjectName}"
                               Visibility="{Binding ResultsViewModel.ProjectObject, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding ResultsViewModel.ProjectObject}"
                               Style="{StaticResource Shell.ProjectName}"
                               Visibility="{Binding ResultsViewModel.ProjectObject, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Меню Файл -->
                <Menu Grid.Column="5" Background="Transparent" VerticalAlignment="Center" Margin="0,0,16,0">
                    <MenuItem Header="Файл" Style="{StaticResource Shell.FileMenuItem}">
                        <MenuItem Header="Сохранить"
                                  Command="{Binding ResultsViewModel.SaveProjectCommand}"
                                  InputGestureText="Ctrl+S"/>
                        <MenuItem Header="Сохранить как..."
                                  Command="{Binding ResultsViewModel.SaveProjectAsCommand}"
                                  InputGestureText="Ctrl+Shift+S"/>
                        <MenuItem Header="Открыть..."
                                  Command="{Binding ResultsViewModel.OpenProjectCommand}"
                                  InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem Header="Создать новый расчёт"
                                  Command="{Binding NewCalculationCommand}"
                                  InputGestureText="Ctrl+N"/>
                        <Separator/>
                        <MenuItem Header="Выход" Click="CloseButton_Click"/>
                    </MenuItem>
                </Menu>

                <!-- «Рассчитать» — бывшая кнопка теплового модуля, перенос в шапку
                     (Фаза 5): ThermalCalculate переехал из ThermalView, контрактный
                     тест обновлён в этой же фазе. -->
                <Button Grid.Column="6"
                        Content="Рассчитать"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding ThermalViewModel.CalculateCommand}"
                        IsEnabled="{Binding ThermalViewModel.IsCalculating, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Выполнить расчёт по текущим данным модулей"
                        AutomationProperties.AutomationId="ThermalCalculate"
                        AutomationProperties.Name="Рассчитать"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>

                <!-- Сплит-кнопка «Отчёт PDF ▾» (Фаза 6): бывшие 5 экспорт-кнопок
                     ResultsView. Гейт — IsDataReady (те же 5 команд ResultsViewModel,
                     внутренняя проверка сохранена); меню открывается по клику
                     (code-behind ставит PlacementTarget/DataContext — ContextMenu
                     вне визуального дерева). CaptionHeight=0/DragMove не задеты. -->
                <Button x:Name="ReportExportButton"
                        Grid.Column="7"
                        Style="{StaticResource Button.Secondary}"
                        IsEnabled="{Binding ResultsViewModel.IsDataReady}"
                        Click="ReportExportButton_Click"
                        ToolTip="Экспорт отчёта: предпросмотр, печать, PDF и Markdown"
                        AutomationProperties.AutomationId="ReportExportButton"
                        AutomationProperties.Name="Отчёт PDF"
                        MinWidth="110"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Отчёт PDF"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Shell.BrandSubtitle}"/>
                        <Path Data="M0,0 L5,5 L10,0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Width="10" Height="5"
                              Stretch="None"
                              Margin="8,2,0,0"
                              VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource Shell.ReportMenu}">
                            <MenuItem Header="Предпросмотр PDF"
                                      Style="{StaticResource Shell.ReportMenuItem}"
                                      Command="{Binding ResultsViewModel.PreviewPdfCommand}"
                                      AutomationProperties.AutomationId="ReportExportPreview"/>
                            <MenuItem Header="Печать"
                                      Style="{StaticResource Shell.ReportMenuItem}"
                                      Command="{Binding ResultsViewModel.PrintPdfCommand}"
                                      AutomationProperties.AutomationId="ReportExportPrint"/>
                            <MenuItem Header="Сохранить PDF..."
                                      Style="{StaticResource Shell.ReportMenuItem}"
                                      Command="{Binding ResultsViewModel.ExportPdfCommand}"
                                      AutomationProperties.AutomationId="ReportExportSavePdf"/>
                            <MenuItem Header="Markdown — рабочий режим"
                                      Style="{StaticResource Shell.ReportMenuItem}"
                                      Command="{Binding ResultsViewModel.ExportOperatingMarkdownReportCommand}"
                                      AutomationProperties.AutomationId="ReportExportMarkdownOperating"/>
                            <MenuItem Header="Markdown — расчётный/холодный"
                                      Style="{StaticResource Shell.ReportMenuItem}"
                                      Command="{Binding ResultsViewModel.ExportDesignColdMarkdownReportCommand}"
                                      AutomationProperties.AutomationId="ReportExportMarkdownDesignCold"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Кнопки управления окном (Фаза 3Б): системный стиль Win11,
                     ячейки 46×56 вплотную к правому верхнему краю.
                     CaptionHeight=0 сохранён — кнопки обычные, chrome не
                     перехватывает клики; DragMove шапки не задет. -->
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button x:Name="WindowMinimizeButton"
                            Style="{StaticResource Shell.WindowButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="Свернуть"
                            AutomationProperties.AutomationId="WindowMinimizeButton"
                            AutomationProperties.Name="Свернуть">
                        <Path Data="{StaticResource Icon.WindowMinimize}"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="WindowMaximizeButton"
                            Click="MaximizeRestoreButton_Click"
                            AutomationProperties.AutomationId="WindowMaximizeButton"
                            AutomationProperties.Name="Развернуть или восстановить">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Shell.WindowButton}">
                                <Setter Property="ToolTip" Value="Развернуть"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="Восстановить"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Style="{StaticResource Shell.WindowMaximizeGlyph}"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="WindowCloseButton"
                            Style="{StaticResource Shell.WindowCloseButton}"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть"
                            AutomationProperties.AutomationId="WindowCloseButton"
                            AutomationProperties.Name="Закрыть">
                        <Path Data="{StaticResource Icon.WindowClose}"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- ТЕЛО: степпер · рабочая область · сводка     -->
        <!-- ============================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Степпер сценария -->
            <Grid Grid.Column="0" x:Name="SidebarGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="230"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Width" Value="70"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="White"
                        BorderBrush="{DynamicResource Brand.Gray.100.Brush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Шаги сценария: ✓ готов · ● черновик · ⚠ ошибка · ⟳ пересчёт.
                             ShellStepperList — селектор UiSmoke (снятие техдолга Ф1Б,
                             план Ф2.6): навигация больше не зависит от эвристики
                             «первый List в окне».
                             Прокрутка отключена (Фаза 3Б): 5 фиксированных пунктов
                             помещаются в минималку 1280×720, переполнение —
                             дефект каркаса, а не кейс для скролла. -->
                        <ListBox Grid.Row="0"
                                AutomationProperties.AutomationId="ShellStepperList"
                                ItemsSource="{Binding MenuItems}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                Margin="0,8,0,8"
                                BorderThickness="0"
                                Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Shell.StepItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource Shell.StepBadge}">
                                            <TextBlock Text="{Binding Number}"
                                                       Style="{StaticResource Shell.StepBadgeText}"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.StepTitle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Shell.StepStatusGlyph}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Кнопка сворачивания степпера -->
                        <Button Grid.Row="1"
                                x:Name="ToggleSidebarButton"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,10"
                                Width="28" Height="28"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="{Binding IsSidebarCollapsed, Converter={StaticResource SidebarTooltipConverter}}"
                                AutomationProperties.Name="Свернуть/развернуть панель навигации"
                                AutomationProperties.HelpText="Нажмите для переключения состояния боковой панели (Ctrl+B)"
                                Style="{StaticResource Shell.SidebarToggleButton}">
                            <Path x:Name="ChevronIcon" Width="16" Height="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Data" Value="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Область контента -->
            <ContentControl Grid.Column="1"
                            x:Name="ModuleContentControl"
                            Content="{Binding CurrentModuleView, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0"
                            Background="{DynamicResource RehauBackgroundBrush}"/>

            <!-- Панель «Сводка»: ≥1680 видна, уже — скрыта (план Ф1.5) -->
            <Border Grid.Column="2"
                    Style="{StaticResource Shell.SummaryRoot}"
                    DataContext="{Binding Summary, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsSummaryVisible, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Window}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="СВОДКА ПРОЕКТА"
                                   Style="{StaticResource Shell.SummaryHeader}"/>

                        <TextBlock Text="Мощность" Style="{StaticResource Shell.SummarySection}"/>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тепловая мощность" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalThermalPowerKw, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValueAccent}"/>
                                <TextBlock Text=" кВт" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Поток вверх q↑" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding PowerUp, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValue}"/>
                                <TextBlock Text=" Вт/м²" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Поток вниз q↓" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding PowerDown, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValue}"/>
                                <TextBlock Text=" Вт/м²" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Суммарный поток q" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding PowerTotal, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValue}"/>
                                <TextBlock Text=" Вт/м²" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Температуры" Style="{StaticResource Shell.SummarySection}"/>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Подача" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding SupplyTemperature, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValueAccent}"/>
                                <TextBlock Text=" °C" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Обратка" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ReturnTemperature, StringFormat={}{0:F1}}"
                                           Style="{StaticResource Shell.SummaryValueTeal}"/>
                                <TextBlock Text=" °C" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Режим" Style="{StaticResource Shell.SummaryLabel}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ModeText}"
                                       Style="{StaticResource Shell.SummaryValue}"/>
                        </Grid>

                        <TextBlock Text="Город" Style="{StaticResource Shell.SummarySection}"/>
                        <TextBlock Text="{Binding City}"
                                   Style="{StaticResource Shell.SummaryValue}"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"/>

                        <!-- Конструкция: R1/R2/λE переезжают сюда из карточки
                             «Результаты расчёта» ConstructionView (Фаза 4, п.4) -->
                        <TextBlock Text="Конструкция" Style="{StaticResource Shell.SummarySection}"/>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Общая толщина" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ConstructionTotalThickness, StringFormat={}{0:F0}}"
                                           Style="{StaticResource Shell.SummaryValue}"/>
                                <TextBlock Text=" мм" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R₁ над трубой" Style="{StaticResource Shell.SummaryLabel}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConstructionR1, StringFormat={}{0:F4}}"
                                       Style="{StaticResource Shell.SummaryValue}"/>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R₂ под трубой" Style="{StaticResource Shell.SummaryLabel}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConstructionR2, StringFormat={}{0:F4}}"
                                       Style="{StaticResource Shell.SummaryValue}"/>
                        </Grid>
                        <Grid Style="{StaticResource Shell.SummaryRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="λЕ вокруг трубы" Style="{StaticResource Shell.SummaryLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ConstructionLambdaE, StringFormat={}{0:F3}}"
                                           Style="{StaticResource Shell.SummaryValue}"/>
                                <TextBlock Text=" Вт/м·К" Style="{StaticResource Shell.SummaryLabel}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Шаги" Style="{StaticResource Shell.SummarySection}"/>
                        <ItemsControl ItemsSource="{Binding DataContext.MenuItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource Shell.SummaryRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Shell.SummaryLabel}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource Shell.StepStatusGlyph}"
                                                   Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- СТАТУС-БАР                                   -->
        <!-- ============================================ -->
        <Border Grid.Row="2" Style="{StaticResource Shell.StatusBarRoot}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="20"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Shell.StatusPlate}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource Status.Warning.Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource Brand.Red.Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Info">
                                        <Setter Property="Background" Value="{DynamicResource Brand.Gray.600.Brush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentModulePlateText}"
                                   Style="{StaticResource Shell.StatusPlateText}"
                                   AutomationProperties.AutomationId="ShellModulePlate"/>
                    </Border>
                    <Path Data="M0,0 L8,0 L0,20 Z"
                          Width="8" Height="20"
                          Stretch="None"
                          VerticalAlignment="Center"
                          Margin="-8,0,8,0">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Brand.Teal.Brush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Warning">
                                        <Setter Property="Fill" Value="{DynamicResource Status.Warning.Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Error">
                                        <Setter Property="Fill" Value="{DynamicResource Brand.Red.Brush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentStatusKind}" Value="Info">
                                        <Setter Property="Fill" Value="{DynamicResource Brand.Gray.600.Brush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </StackPanel>

                <!-- Сообщение валидации/статуса активного модуля (перенос из
                     полноширинных карточек вьюх; AutomationId контракта —
                     ThermalAutomationIdSelectorContractTests) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentValidationText}"
                           Style="{StaticResource Shell.StatusText}"
                           AutomationProperties.AutomationId="ShellValidationMessage"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentRecalcText, StringFormat='⟳ {0}'}"
                           Style="{StaticResource Shell.RecalcText}"
                           Visibility="{Binding CurrentRecalcText, Converter={StaticResource StringToVisibilityConverter}}"
                           AutomationProperties.AutomationId="ShellRecalcMessage"/>
            </Grid>
        </Border>
    </Grid>

</Window>
