<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SnowMeltingCalculator</AssemblyName>
    <RootNamespace>SnowMeltingCalculator</RootNamespace>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Authors>REHAU</Authors>
    <Product>Калькулятор снеготаяния РЕХАУ</Product>
    <Description>Расчёт систем снеготаяния открытых площадок</Description>
    
    <!-- Настройки публикации -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- LaTeX-вёрстка формул PDF-записки (мини-фаза PDF-PZ): MIT,
         рендер формул в PNG через SkiaSharp (нативный ассет win-x64). -->
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnowMeltingCalculator.Tests" />
  </ItemGroup>

  <!-- Базы данных -->
  <ItemGroup>
    <None Include="..\data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>data\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- Полная инструкция пользователя (Файл → Инструкция): README.html и
       media/ деплоятся рядом с exe, относительные ссылки HTML работают. -->
  <ItemGroup>
    <None Include="..\docs\Инструкция полная\README.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>docs\Инструкция полная\README.html</TargetPath>
    </None>
    <None Include="..\docs\Инструкция полная\media\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>docs\Инструкция полная\media\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- Шрифты Inter -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Логотип для колонтитула PDF-отчёта (мини-фаза PDF-PZ, §7.2):
       читается из g.resources, без deploy-файла. -->
  <ItemGroup>
    <Resource Include="Resources\Images\rehau_logo.png" />
    <!-- Подложки корешка и белая версия знака: PDF «Результаты расчёта»
         (дизайн «Корешок + плитки», план 2026-09-09). -->
    <Resource Include="Resources\Images\rehau_spine_page1.png" />
    <Resource Include="Resources\Images\rehau_spine_page2.png" />
    <Resource Include="Resources\Images\rehau_logo_white.png" />
  </ItemGroup>

  <!-- Фирменные SVG-ассеты -->
  <ItemGroup>
    <Resource Include="Assets\Brand\*.svg" />
  </ItemGroup>

</Project>
