<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SnowMeltingCalculator</AssemblyName>
    <RootNamespace>SnowMeltingCalculator</RootNamespace>
    <Version>1.8.0</Version>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Authors>REHAU</Authors>
    <Product>Калькулятор снеготаяния РЕХАУ</Product>
    <Description>Расчёт систем снеготаяния открытых площадок</Description>

    <!-- Publish-параметры (SelfContained/RuntimeIdentifier/PublishReadyToRun)
         переехали в Properties/PublishProfiles/winx64.pubxml (волна «хвосты»
         2026-09-20); командная строка публикует с профилем или флагами —
         см. INSTALL.md и .github/workflows/release.yml. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <!-- LaTeX-вёрстка формул PDF-записки (мини-фаза PDF-PZ): MIT,
         рендер формул в PNG через SkiaSharp (нативный ассет win-x64). -->
    <PackageReference Include="CSharpMath.SkiaSharp" />
    <PackageReference Include="SharpVectors.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SnowMeltingCalculator.Tests" />
  </ItemGroup>

  <!-- Базы данных -->
  <ItemGroup>
    <None Include="..\data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>data\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- Инструкция пользователя (Файл → Инструкция): self-contained HTML
       (скриншоты встроены base64), деплоится рядом с exe. -->
  <ItemGroup>
    <None Include="..\docs\manual\README.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>docs\manual\README.html</TargetPath>
    </None>
  </ItemGroup>

  <!-- Шрифты Inter -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Логотип для колонтитула PDF-отчёта (мини-фаза PDF-PZ, §7.2):
       читается из g.resources, без deploy-файла. -->
  <ItemGroup>
    <Resource Include="Resources\Images\rehau_logo.png" />
    <!-- Подложки корешка и белая версия знака: PDF «Результаты расчёта»
         (дизайн «Корешок + плитки», план 2026-09-09). -->
    <Resource Include="Resources\Images\rehau_spine_page1.png" />
    <Resource Include="Resources\Images\rehau_spine_page2.png" />
    <Resource Include="Resources\Images\rehau_logo_white.png" />
  </ItemGroup>

  <!-- Фирменные SVG-ассеты -->
  <ItemGroup>
    <Resource Include="Assets\Brand\*.svg" />
  </ItemGroup>

</Project>
