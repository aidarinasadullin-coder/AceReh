<?xml version="1.0" encoding="utf-8"?>
<!-- Профиль публикации самодостаточной поставки win-x64 (волна «хвосты»,
     план 2026-09-18 §9): publish-параметры переехали сюда из
     src/SnowMeltingCalculator.csproj. Запуск из корня репозитория:
     dotnet publish src/SnowMeltingCalculator.csproj -c Release -p:PublishProfile=winx64
     (эквивалент прежних флагов: рантайм win-x64, self-contained, ReadyToRun).
     Установщик installer/*.iss пакует содержимое publish\ — см. INSTALL.md. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
