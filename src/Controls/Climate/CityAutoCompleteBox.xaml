<UserControl x:Class="SnowMeltingCalculator.Controls.Climate.CityAutoCompleteBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SnowMeltingCalculator.Converters"
             xmlns:attached="clr-namespace:SnowMeltingCalculator.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="300"
             x:Name="Root">

    <UserControl.Resources>
        <converters:CityMatchToHighlightConverter x:Key="HighlightConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Контейнер для TextBox и Placeholder.
             Поле города — канон .f .in (TextBox.Default: высота 34, паддинг
             10,0): локальный Padding="12,8" поверх дефолта сжимал контентную
             зону до 18px и клиповал текст (дефект, решение — Фаза 5,
             ADR-006 п.1). -->
        <Grid>
            <!-- TextBox для ввода -->
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding SearchQuery, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     KeyDown="OnKeyDown"
                     GotFocus="OnGotFocus"
                     LostFocus="OnLostFocus"
                     Style="{StaticResource TextBox.Default}"/>

<!-- Placeholder -->
            <TextBlock x:Name="PlaceholderTextBlock"
                        Text="{Binding PlaceholderText, ElementName=Root}"
                        Foreground="{DynamicResource Brand.Gray.600.Brush}"
                        FontSize="{StaticResource Font.Size.Body}"
                        Margin="11,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Visible"/>
        </Grid>

        <!-- Выпадающий список -->
        <Popup x:Name="SuggestionsPopup"
               PlacementTarget="{Binding ElementName=SearchTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               Width="{Binding ActualWidth, ElementName=SearchTextBox}"
               MaxHeight="300"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsPopupOpen, ElementName=Root, Mode=TwoWay}"
               Opened="OnPopupOpened"
               Closed="OnPopupClosed">
            <Border Background="White"
                    BorderBrush="{DynamicResource Brand.Gray.100.Brush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.SM}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SuggestionsList"
                         ItemsSource="{Binding FilteredCities, ElementName=Root}"
                         SelectedIndex="{Binding SelectedSuggestionIndex, ElementName=Root, Mode=TwoWay}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnSelectionChanged"
                         MouseLeftButtonUp="OnSuggestionClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Название города -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           attached:InlinesProperty.Inlines="{Binding HighlightedName, Converter={StaticResource HighlightConverter}}"
                                           FontWeight="Bold"/>

                                <!-- Регион -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           attached:InlinesProperty.Inlines="{Binding HighlightedRegion, Converter={StaticResource HighlightConverter}}"
                                           FontSize="11"/>

                                <!-- Температура и зона -->
                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TemperatureDisplay, Mode=OneWay}"
                                              Foreground="{DynamicResource RehauTealBrush}"
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ZoneDisplay, Mode=OneWay}"
                                              Foreground="{DynamicResource RehauGrayBrush}"
                                              FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>