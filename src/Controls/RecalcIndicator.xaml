<!--
    ================================================================================
    REHAU Снеготаяние - UserControl: Индикатор пересчёта
    ================================================================================
    
    Назначение: Готовый компонент для отображения статуса пересчёта
    
    Использование:
    <controls:RecalcIndicator State="{Binding RecalcState}"
                              Message="{Binding RecalcMessage}"
                              ShowButton="{Binding ShowRecalculateButton}"
                              RecalculateCommand="{Binding RecalculateCommand}"/>
    
    Состояния (RecalcState):
    - Info: Данные актуальны (серый)
    - Warning: Требуется пересчёт (жёлтый)
    - Processing: Выполняется пересчёт (синий)
    - Success: Пересчёт завершён (зелёный)
    
    ================================================================================
-->
<UserControl x:Class="SnowMeltingCalculator.Controls.RecalcIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:SnowMeltingCalculator.Models.Enums"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="600">
    
    <UserControl.Resources>
        <!-- Иконки состояний (Geometry) -->
        <Geometry x:Key="Icon.Info">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</Geometry>
        <Geometry x:Key="Icon.Warning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</Geometry>
        <Geometry x:Key="Icon.Processing">M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z</Geometry>
        <Geometry x:Key="Icon.Check">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>
        
        <!-- Конвертер для видимости кнопки -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource RecalcIndicator.Container}">
                <Style.Triggers>
                    <!-- Warning State (жёлтый) -->
                    <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 Value="{x:Static enums:RecalcState.Warning}">
                        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Warning}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Warning}"/>
                    </DataTrigger>
                    <!-- Processing State (синий) -->
                    <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 Value="{x:Static enums:RecalcState.Processing}">
                        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Processing}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Processing}"/>
                    </DataTrigger>
                    <!-- Success State (зелёный) -->
                    <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 Value="{x:Static enums:RecalcState.Success}">
                        <Setter Property="Background" Value="{StaticResource RecalcIndicator.Bg.Success}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Color.Border.Success}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Иконка состояния (Path вместо PathIcon) -->
            <Path Grid.Column="0" 
                  Width="20" 
                  Height="20" 
                  Margin="0,0,12,0"
                  Stretch="Uniform">
                <Path.Style>
                    <Style TargetType="Path" BasedOn="{StaticResource RecalcIndicator.Icon}">
                        <Setter Property="Data" Value="{StaticResource Icon.Info}"/>
                        <Style.Triggers>
                            <!-- Warning -->
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Warning}">
                                <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
                                <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Warning}"/>
                            </DataTrigger>
                            <!-- Processing -->
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Processing}">
                                <Setter Property="Data" Value="{StaticResource Icon.Processing}"/>
                                <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Processing}"/>
                            </DataTrigger>
                            <!-- Success -->
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Success}">
                                <Setter Property="Data" Value="{StaticResource Icon.Check}"/>
                                <Setter Property="Fill" Value="{StaticResource RecalcIndicator.Text.Success}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
            
            <!-- Текст сообщения -->
            <TextBlock Grid.Column="1">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecalcIndicator.Text}">
                        <Setter Property="Text" Value="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Данные актуальны'}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Warning}">
                                <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Processing}">
                                <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Processing}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         Value="{x:Static enums:RecalcState.Success}">
                                <Setter Property="Foreground" Value="{StaticResource RecalcIndicator.Text.Success}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
            <!-- Кнопка пересчёта (только для Warning) -->
            <Button Grid.Column="2"
                    Style="{StaticResource Button.Primary}"
                    Content="Пересчитать"
                    Command="{Binding RecalculateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding ShowButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
