<Window x:Class="SnowMeltingCalculator.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="Загрузка"
        Width="600" Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brand.Gradient.Red.Intensive}"
        FontFamily="{StaticResource FontFamily.Main}"
        TextElement.Foreground="White">

    <!--
        Сплэш (Ф7.2, рендер 06): Red.Intensive на весь экран, белый логотип
        по центру (официальная композиция финального слайда, §3.1 бренд-дока),
        декор «квадраты» в фирменных цветах. Строка о нормативных данных на
        сплэше отсутствует — решение владельца (журнал п.10).
        Title нейтральный: UiSmoke находит главное окно по заголовку
        «Калькулятор снеготаяния REHAU» (UiSmokeApplication.Launch).
    -->
    <Grid>
        <!-- Декор «квадраты» (§5.3): 4×3, X/½X-ритм, не более одного
             вхождения на экран. Схема заливок — по рендеру 06. -->
        <UniformGrid Columns="4"
                     Width="87" Height="64"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,28,28,0">
            <Border Style="{StaticResource Brand.Square}" Background="{DynamicResource Brand.Red.Pale.Brush}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}" Background="White"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}" Background="{DynamicResource Brand.Teal.Soft.Brush}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}"/>
            <Border Style="{StaticResource Brand.Square}" Background="{DynamicResource Brand.Red.Pale.Brush}"/>
        </UniformGrid>

        <!-- Центральная композиция: логотип + имя + слоган -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <svgc:SvgViewbox Source="pack://application:,,,/Assets/Brand/logo_white.svg"
                             Height="72"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,30"/>
            <TextBlock Text="Калькулятор снеготаяния"
                       FontSize="{StaticResource Font.Size.Display}"
                       FontFamily="{StaticResource FontFamily.Inter.ExtraBold}"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Расчёт систем обогрева открытых площадок РЕХАУ"
                       FontSize="{StaticResource Font.Size.Body}"
                       Opacity="0.85"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,52,0,0"
                        Opacity="0.75">
                <TextBlock x:Name="VersionText"
                           Text="v"
                           FontSize="{StaticResource Font.Size.Caption}"/>
                <TextBlock Text="·"
                           FontSize="{StaticResource Font.Size.Caption}"
                           Opacity="0.4"
                           Margin="12,0"/>
                <TextBlock Text="Ваше преимущество РЕХАУ"
                           FontSize="{StaticResource Font.Size.Caption}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="© РЕХАУ"
                   FontSize="{StaticResource Font.Size.Caption}"
                   Opacity="0.45"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="28,0,0,22"/>
    </Grid>
</Window>
