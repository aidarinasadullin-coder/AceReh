<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SnowMeltingCalculator.Tests</RootNamespace>
    <!-- Временно подавляем pre-existing warnings в тестах, чтобы сборка проходила с TreatWarningsAsErrors.
         Пункт 12 docs/Планируемые_изменения.md предусматривает их постепенное устранение. -->
    <NoWarn>CS8618;CS8625;CS0219;CS0618;CS8602;CS8604;CS8600;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Dev-only зависимость UI smoke-набора (Фаза 1Б редизайна): MIT,
         в дистрибутив приложения не попадает (см. docs/design/redesign-plan.md). -->
    <PackageReference Include="FlaUI.UIA3" />
    <!-- PoC VirtualizingWrapPanel (Фаза 2 редизайна, план Ф2.4): MIT, 0 зависимостей.
         Dev-only на этом этапе: PoC-критерии встроены в приёмку как STA-тесты;
         PackageReference в src добавляется фазой первого внедрения в разметку
         (Ф3/Ф6) — решение зафиксировано в плане Ф2 и ADR-006. -->
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SnowMeltingCalculator.csproj" />
  </ItemGroup>

</Project>